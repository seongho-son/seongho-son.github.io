---
import '../styles/global.css';
const { title = '레시피 모음', description = '유튜브에서 찾은 인기 집밥 레시피를 요리할 때 보기 편하게 담았어요.', image, imageAlt, type = 'website', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    {!noindex && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5644793210860513" crossorigin="anonymous"></script>}
    <meta name="google-adsense-account" content="ca-pub-5644793210860513" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 레시피 나와라 뚝딱</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} · 레시피 나와라 뚝딱`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <link rel="alternate" type="application/rss+xml" title="레시피 나와라 뚝딱" href="/rss.xml" />
    <slot name="head" />
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="레시피 나와라 뚝딱 홈">레시피 나와라 <span>뚝딱!</span></a>
      <p class="blog-intro">유튜브에서 찾은 인기 레시피,<br class="mobile-break" /> 요리할 때 보기 편하게 담았어요.</p>
      <nav aria-label="주 메뉴"><a href="/" aria-current={Astro.url.pathname === "/" ? "page" : undefined}>레시피 모음</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer><a class="brand" href="/">레시피 나와라 뚝딱</a><p>집에서 만드는 밥 이야기.</p><nav aria-label="사이트 안내"><a href="/about/">소개</a><a href="/contact/">문의</a><a href="/privacy/">개인정보 안내</a><a href="/rss.xml">RSS</a></nav></footer>
  </body>
</html>
