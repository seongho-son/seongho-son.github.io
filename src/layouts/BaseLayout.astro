---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  /** 이 페이지가 글(article)인지 여부 — OG type / Article 스키마 결정 */
  article?: boolean;
  /** 넓은 레이아웃(홈/목록)인지 여부 */
  wide?: boolean;
  /** 글 발행일(ISO) — Article 스키마 datePublished */
  publishedDate?: string;
  /** 글 수정일(ISO) — Article 스키마 dateModified */
  modifiedDate?: string;
}

const { title, description, article = false, wide = false, publishedDate, modifiedDate } = Astro.props;
const siteName = '얼마받지';
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://seongho-son.github.io';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const ogImage = `${siteUrl}/og-image.png`;

// 애드센스 게시자 ID. head에 스크립트가 로드되어 사이트 연결·자동광고가 활성화됩니다.
const ADSENSE_CLIENT = 'ca-pub-5644793210860513';

// 구글 서치콘솔 메타 인증(선택). HTML 파일 방식(public/google….html)으로 이미 인증했다면 비워둬도 됨.
const GSC_VERIFICATION = '';

// JSON-LD 구조화 데이터 (WebSite + Organization 전역, 글이면 Article 추가)
const graph = [
  { '@type': 'WebSite', name: siteName, url: siteUrl + '/', inLanguage: 'ko-KR' },
  { '@type': 'Organization', name: siteName, url: siteUrl + '/' },
];
if (article && publishedDate) {
  graph.push({
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: 'ko-KR',
    datePublished: publishedDate,
    dateModified: modifiedDate || publishedDate,
    mainEntityOfPage: canonical,
    author: { '@type': 'Organization', name: siteName },
    publisher: { '@type': 'Organization', name: siteName },
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {GSC_VERIFICATION && (
      <meta name="google-site-verification" content={GSC_VERIFICATION} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%23c2410c'/><text x='50' y='54' text-anchor='middle' dominant-baseline='middle' font-family='-apple-system,BlinkMacSystemFont,AppleSDGothicNeo-Bold,Malgun Gothic,sans-serif' font-size='64' font-weight='800' fill='%23ffffff'>얼</text></svg>" />

    <!-- 구조화 데이터 (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <div class={wide ? 'container wide' : 'container'}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
