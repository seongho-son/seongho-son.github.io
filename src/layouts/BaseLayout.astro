---
import '../styles/global.css';
const { title = '돼지고기 김치찌개', description = '한 냄비로 차리는 오늘의 집밥. 1–2인분과 3–4인분 재료를 나란히 보고, 종이컵과 숟가락으로 만드는 김치찌개.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 오늘의 한 냄비</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} · 오늘의 한 냄비`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/kimchi-jjigae.webp', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="오늘의 한 냄비 홈"><span class="brand-mark" aria-hidden="true">♨</span> 오늘의 한 냄비</a>
      <nav aria-label="주 메뉴"><a href="/#ingredients">오늘의 레시피</a><a href="/about/">우리의 식탁</a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer><a class="brand" href="/">오늘의 한 냄비</a><p>혼자 먹는 날에도, 함께 먹는 날에도.</p><nav aria-label="사이트 안내"><a href="/about/">소개</a><a href="/contact/">문의</a><a href="/privacy/">개인정보 안내</a></nav></footer>
  </body>
</html>
