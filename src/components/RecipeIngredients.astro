---
interface Props {
  ingredients: string[][];
  groups: [string, number[]][];
}
const { ingredients, groups } = Astro.props;
const indices = groups.flatMap(([, ids]) => ids);
if (indices.length !== ingredients.length || new Set(indices).size !== ingredients.length || indices.some(i => !ingredients[i])) {
  throw new Error('Ingredient groups must include each ingredient exactly once');
}
---
<div class="ingredient-memos">
  {[1, 2].map(portion => <section class="ingredient-portion" aria-label={portion === 1 ? '1–2인분 재료' : '3–4인분 재료'}>
    <h3>{portion === 1 ? '1–2인분' : '3–4인분'}</h3>
    {groups.map(([name, ids]) => <section class="ingredient-group">
      <h4>{name}</h4>
      <ul>{ids.map(i => <li>
        <span class="ingredient-label">{ingredients[i][0].replace(' · 밑간용', '')}</span>{' '}
        <strong>{ingredients[i][portion].replace(/^종이컵\s+/, '').split('(')[0]}</strong>{ingredients[i][portion].includes('(') && <small> ({ingredients[i][portion].split('(').slice(1).join('(')}</small>}
      </li>)}</ul>
    </section>)}
  </section>)}
</div>
<style>
  .ingredient-memos { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:30px; margin:26px 0; }
  .ingredient-portion { min-width:0; }
  .ingredient-portion + .ingredient-portion { border-left:1px solid var(--line); padding-left:24px; }
  .ingredient-portion h3 { font-size:18px; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid currentColor; }
  .ingredient-group h4 { font-size:14px; color:var(--accent); margin:22px 0 10px; font-weight:600; }
  .ingredient-group ul { list-style:none; padding:0; margin:0; }
  .ingredient-group li { padding:7px 0; min-height:38px; line-height:1.65; font-size:15px; word-break:keep-all; overflow-wrap:anywhere; }
  .ingredient-group strong { font-weight:700; }
  .ingredient-group small { font-size:12px; color:#777; }
  @media(max-width:600px) {
    .ingredient-memos { gap:16px; }
    .ingredient-portion + .ingredient-portion { padding-left:16px; }
    .ingredient-group li { font-size:14px; }
    .ingredient-portion h3 { font-size:17px; }
  }
</style>
