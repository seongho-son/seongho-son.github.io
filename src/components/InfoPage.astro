---
interface Props { title: string; label: string; }
const { title, label } = Astro.props;
---
<article class="info-page">
  <header class="info-heading">
    <p class="info-label">{label}</p>
    <h1>{title}</h1>
    <nav aria-label="블로그 안내">
      <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>소개</a>
      <a href="/contact/" aria-current={Astro.url.pathname === '/contact/' ? 'page' : undefined}>문의</a>
    </nav>
  </header>
  <div class="info-body"><slot /></div>
</article>
<style is:global>
  .info-page { padding: 48px 32px 64px; display: grid; grid-template-columns: minmax(200px, 280px) minmax(0, 1fr); gap: 64px; }
  .info-heading { min-width: 0; }
  .info-label { margin: 0 0 12px; font-size: 12px; color: var(--accent); }
  .info-heading h1 { margin: 0; font-size: 28px; line-height: 1.5; letter-spacing: -.8px; }
  .info-heading nav { display: flex; gap: 24px; margin-top: 20px; }
  .info-heading nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; color: #777; text-decoration: none; }
  .info-heading nav a[aria-current=page] { color: var(--accent); font-weight: 600; }
  .info-body { max-width: 680px; min-width: 0; font-size: 16px; line-height: 1.85; }
  .info-body p { margin: 0 0 18px; }
  .info-body .info-lead { font-size: 21px; line-height: 1.65; font-weight: 600; letter-spacing: -.4px; word-break: keep-all; margin-bottom: 18px; }
  .info-body section + section { margin-top: 28px; padding-top: 26px; border-top: 1px solid var(--line); }
  .info-body h2 { font-size: 17px; line-height: 1.6; font-weight: 600; margin: 0 0 12px; }
  .info-body section > :last-child { margin-bottom: 0; }
  .info-body .info-note { color: #777; font-size: 13px; line-height: 1.85; }
  .info-action { display: inline-flex; align-items: center; min-height: 44px; color: var(--accent); text-decoration: none; font-weight: 600; font-size: 14px; }
  .info-action:hover { text-decoration: underline; }
  .contact-address { display: block; width: fit-content; max-width: 100%; font-size: 21px; font-weight: 600; color: var(--accent); text-decoration: none; overflow-wrap: anywhere; padding: 6px 0; line-height: 1.6; }
  .contact-address:hover { text-decoration: underline; }
  .contact-details { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 12px 20px; margin: 18px 0 0; font-size: 14px; }
  .contact-details dt { color: #777; }
  .contact-details dd { margin: 0; }
  @media (min-width:641px) and (max-width:1023px) { .info-page { grid-template-columns: 180px minmax(0, 1fr); gap: 32px; padding-inline: 24px; } .info-heading h1 { font-size: 25px; } }
  @media (max-width:640px) {
    .info-page { display: block; padding: 28px 20px 44px; }
    .info-heading { padding-bottom: 20px; margin-bottom: 24px; border-bottom: 1px solid var(--line); }
    .info-label { margin-bottom: 8px; font-size: 11px; }
    .info-heading h1 { font-size: 25px; }
    .info-heading nav { margin-top: 12px; }
    .info-body { font-size: 15px; }
    .info-body .info-lead { font-size: 19px; }
    .info-body h2 { font-size: 16px; }
    .contact-address { font-size: 18px; }
    .contact-details { grid-template-columns: 80px minmax(0, 1fr); gap: 12px; font-size: 13px; }
  }
</style>
