---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '');

// 메뉴는 4개로 고정. 모바일(375px)에서 로고 + 5개 항목은 줄바꿈으로 무너진다.
// '소개'는 푸터에 이미 있으므로 헤더에서 뺀다.
// short 는 480px 이하에서만 쓰는 축약 라벨 — 4개가 한 줄에 다 들어가야 스크롤 없이 보인다.
const nav = [
  { href: '/prepare', label: '신청 준비', short: '준비', on: (p: string) => p === '/prepare' },
  { href: '/tools', label: '계산기', short: '계산기', on: (p: string) => p.startsWith('/tools') },
  { href: '/guides', label: '조건과 사례', short: '사례', on: (p: string) => p.startsWith('/guides') },
];
---
<header class="site-header">
  <div class="container wide">
    <a class="brand" href={`${base}/`}>얼마<span class="brand-accent">받지</span></a>
    <nav class="nav">
      {nav.map((n) => (
        <a
          href={`${base}${n.href}`}
          class={n.on(path) ? 'on' : ''}
          aria-current={n.on(path) ? 'page' : undefined}
        >
          <span class="lbl-full">{n.label}</span><span class="lbl-short">{n.short}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
