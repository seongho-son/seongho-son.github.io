---
import RecipeBook from '../../components/RecipeBook.astro';
import { ingredientGroups } from '../../data/ingredient-groups.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedRecipes from '../../components/RelatedRecipes.astro';
import CookedSection from '../../components/CookedSection.astro';
import { searchTitle } from '../../data/search-title.js';
import { additionalRecipes } from '../../data/more-recipes.js';
export function getStaticPaths() {
  return additionalRecipes.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { dish, ingredients, steps, recipeMeta, tips } = entry;
const pageUrl = new URL(recipeMeta.path, Astro.site).href;
const sourceUrl = `https://www.youtube.com/watch?v=${entry.videoId}`;
const recipe = {
  '@context':'https://schema.org', '@type':'Recipe', '@id':`${pageUrl}#recipe`,
  name:recipeMeta.title, description:recipeMeta.description,
  image:recipeMeta.image, url:pageUrl,
  inLanguage:'ko-KR', recipeCuisine:'한식', recipeCategory:dish, recipeYield:'1–2인분',
  recipeIngredient:ingredients.map(([name, small]) => `${name} ${small}`),
  recipeInstructions:steps.map((step, i) => ({
    '@type':'HowToStep', name:step.name,
    text:step.paragraphs.map(p => p.replace(/<[^>]*>/g, '')).join(' '),
    url:`${pageUrl}#step-${i + 1}`,
  })), citation:sourceUrl,
};
---
<BaseLayout title={searchTitle(recipeMeta)} description={recipeMeta.description} image={recipeMeta.image} imageAlt={recipeMeta.imageAlt} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(recipe).replace(/</g, '\\u003c')} />
  <div class="recipe-layout">
    <article class="post" id="recipe-top">
      <figure class="post-video">
        {entry.embed ? <iframe src={`https://www.youtube-nocookie.com/embed/${entry.videoId}`} title={`${entry.channel} ${dish} 원본 영상`} width="1280" height="720" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe> : <a class="video-source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer"><img src={recipeMeta.image} width={entry.thumbnailWidth ?? 1280} height={entry.thumbnailHeight ?? 720} alt={recipeMeta.imageAlt} decoding="async" /><span>유튜브에서 영상 보기 ↗</span></a>}
      </figure>
      <header class="post-header">
        <a class="category" href="/">{entry.category}</a>
        <h1>{recipeMeta.title}</h1>
      </header>
      <div class="post-content">
        {entry.intro.map(p => <p set:html={p} />)}
        <RecipeBook ingredients={ingredients} groups={entry.ingredientGroups ?? ingredientGroups[entry.slug]} steps={steps} measureNote={entry.measureNote} portionNotes={[entry.portionNote]} tips={tips}>
          {entry.cooked && <CookedSection cooked={entry.cooked} />}
          <aside class="source-note" aria-label="레시피 출처">
            <p><strong>참고한 영상</strong><br /><a href={sourceUrl} target="_blank" rel="noopener noreferrer">{entry.channel} · {dish} ↗</a></p>
            <p>{entry.sourceNote}</p>
            {entry.sourceUrl && <p><a href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">제작자의 공식 재료·조리법 보기 ↗</a></p>}
          </aside>
        </RecipeBook>
        <p class="post-tags">{entry.tags}</p>
        <RelatedRecipes path={recipeMeta.path} />
      </div>
    </article>
  </div>
</BaseLayout>
