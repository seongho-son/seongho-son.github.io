---
import RecipeBook from '../../components/RecipeBook.astro';
import { ingredientGroups } from '../../data/ingredient-groups.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedRecipes from '../../components/RelatedRecipes.astro';
import CookedSection from '../../components/CookedSection.astro';
import { searchTitle } from '../../data/search-title.js';
import { ingredients, steps, tips, cooked, recipeMeta } from '../../data/kim-seoul-jeyuk.js';
const pageUrl = new URL(recipeMeta.path, Astro.site).href;
const sourceUrl = 'https://www.youtube.com/watch?v=PlLBBlFEmLg';
const recipe = {
  '@context': 'https://schema.org', '@type': 'Recipe', '@id': `${pageUrl}#recipe`,
  name: recipeMeta.title, description: recipeMeta.description,
  image: recipeMeta.image, url: pageUrl,
  inLanguage: 'ko-KR', recipeCuisine: '한식', recipeCategory: '볶음', recipeYield: '1–2인분',
  recipeIngredient: ingredients.map(([name, small]) => `${name} ${small}`),
  recipeInstructions: steps.map((step, i) => ({
    '@type': 'HowToStep', name: step.name,
    text: step.paragraphs.map(p => p.replace(/<[^>]*>/g, '')).join(' '),
    url: `${pageUrl}#step-${i + 1}`,
  })),
  citation: sourceUrl,
};
---
<BaseLayout title={searchTitle(recipeMeta)} description={recipeMeta.description} image={recipeMeta.image} imageAlt={recipeMeta.imageAlt} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(recipe).replace(/</g, '\\u003c')} />
  <div class="recipe-layout">
    <article class="post" id="recipe-top">
      <figure class="post-video post-video-link">
          <a class="video-source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer" aria-label="킴서울 제육볶음 원본 영상 유튜브에서 보기 (새 탭)">
            <img src="https://i.ytimg.com/vi/PlLBBlFEmLg/maxresdefault.jpg" width="1280" height="720" alt="킴서울 제육볶음 원본 영상 썸네일" decoding="async" />
            <span>유튜브에서 영상 보기 ↗</span>
          </a>
        </figure>
      <header class="post-header">
        <a class="category" href="/">집밥 레시피</a>
        <h1>{recipeMeta.title}</h1>
      </header>
      <div class="post-content">
        <p>조회수 1,000만을 넘긴 제육볶음. 여러 레시피를 돌다 이걸로 정착했어요.</p>
        <RecipeBook ingredients={ingredients} groups={ingredientGroups['kim-seoul-jeyuk']}
          steps={steps.map((step, i) => i === 2 ? { ...step, reactionHtml: '<span class="reaction-emoji" role="img" aria-label="머쓱한 웃음">😅</span> 양념장까지 한 번에 넣고 싶지만, 여기서는 고기부터! 옆에 잠깐 두세요.' } : step)}
          measureNote="큰술은 밥숟가락 기준으로 적었어요. 원본 댓글의 ‘스푼’을 옮긴 것으로, 숟가락 크기와 담는 양에 따라 차이가 날 수 있어요."
          portionNotes={['고기는 제육용으로 얇게 썰어 준비해주세요. 원본 한 근을 3–4인분, 절반을 1–2인분으로 나눈 기준이에요.', '식용유는 팬에 얇게 두를 만큼, 통깨는 마무리에 조금 준비해주세요.']} 
          tips={[{ id: 'sweetness', title: '단맛이 걱정된다면 물엿부터 조절해요', html: true, paragraphs: ['덜 달게 먹고 싶을 때 참고할 만한 팁도 있어요. 한 시청자는 밑간 설탕은 그대로 두고, 양념장의 물엿을 절반으로 줄여 먹는다고 했어요.', '덜 달게 먹는 편이라면 이 방법을 참고해보세요. <strong>1–2인분은 물엿 ½큰술, 3–4인분은 1큰술</strong>로 줄이는 방식이에요. 위 재료표는 원본 그대로이며, 이건 시청자가 소개한 변형이에요.', '국도 곁들이고 싶다면 <a href="/recipes/kimchi-jjigae/">백종원 김치찌개</a>도 함께 볼 수 있어요.'] }, ...tips]}>
          {cooked && <CookedSection cooked={cooked} />}
          <aside class="source-note" aria-label="레시피 출처">
            <p><strong>참고한 영상</strong><br /><a href={sourceUrl} target="_blank" rel="noopener noreferrer">킴서울 · 많은 분들이 좋아해주신 제육볶음 레시피 ↗</a><br /><a href={`${sourceUrl}&lc=Ugy_SJRFCkSNL9UBFgF4AaABAg`} target="_blank" rel="noopener noreferrer">레시피가 적힌 고정 댓글 보기 ↗</a></p>
            <p>작성자 고정 댓글의 배합과 순서를 기준으로 정리했어요. 조회수와 시청자 반응은 2026년 9월 28일 확인했으며, 소개한 후기는 일부 시청자의 경험입니다. 인분 환산, 손질 크기와 불 조절은 덧붙인 설명이고 직접 조리 검증 전입니다.</p>
            <p>원작자와 제휴 관계는 없습니다.</p>
          </aside>
        </RecipeBook>
        <p class="post-tags">#제육볶음 #킴서울레시피 #앞다리살 #집밥</p>
        <RelatedRecipes path={recipeMeta.path} />
      </div>
    </article>
  </div>
</BaseLayout>
