---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOURCES } from '../lib/editorial.js';
const items = [
 ['year', '소득연도와 신청 유형을 확인했어요', '2025년 소득분 정기·기한 후 신청인지, 2026년 소득분 반기 신청인지 구분하세요.', '/guides/labor-tax-credit-late-apply/'],
 ['household', '가구 구분과 부양 관계를 확인했어요', '배우자와 부양가족 요건을 확인하세요. 혼자 사는지, 부부가 모두 일하는지만으로 정하지 마세요.', '/guides/labor-tax-credit-guide/'],
 ['income', '연간 소득 자료를 준비했어요', '총소득과 총급여액 등을 나눠 확인하고, 배우자 소득과 근로 외 소득을 빠뜨리지 마세요.', '/guides/labor-tax-credit-guide/'],
 ['property', '기준일의 가구원 재산을 확인했어요', '2025년 소득분은 2025년 6월 1일 재산입니다. 대출을 빼지 말고 전세금 평가 방법도 확인하세요.', '/guides/labor-tax-credit-property/'],
 ['child', '자녀 요건·세액공제를 확인했거나 해당 없어요', '자녀장려금을 신청하면 나이·소득·부양 요건과 연말정산 자녀세액공제를 확인하세요.', '/guides/child-tax-credit/'],
 ['history', '기존 신청 내역과 공식 접수 경로를 확인했어요', '반기 신청 여부와 접수 내역을 확인한 뒤 홈택스 공식 안내로 진행하세요.', '/guides/labor-tax-credit-payment-date/'],
];
---
<BaseLayout title="장려금 신청 준비 목록" description="소득연도·가구·소득·재산·자녀·신청 내역을 확인하고 남은 준비 항목을 인쇄하세요.">
<h1>장려금 신청 준비 목록</h1><p class="lead">모르는 항목을 찾고, 확인할 자료를 정리하세요.</p>
<p>체크를 모두 해도 수급 자격이 확정되는 것은 아닙니다. 입력·체크 내용은 서버로 보내거나 저장하지 않으며, 페이지를 새로 열면 초기화됩니다.</p>
<aside class="disclaimer-box"><strong>2025년 소득분 · 2026년 신청 일정</strong><p>정기 접수는 5월 1일~6월 1일, 기한 후 접수는 12월 1일까지입니다. 2026-09-21 확인한 일정으로, 실제 접수 전 <a href={SOURCES.announcement}>국세청 공고</a>를 확인하세요.</p></aside>
<form id="prepare-form">
{items.map(([id,title,desc,href]) => <section class="prepare-item"><label><input type="checkbox" name={id} data-title={title} /> <strong>{title}</strong></label><p>{desc} <a href={href}>확인 방법</a></p></section>)}
<p id="progress" aria-live="polite">확인한 항목 0 / 6</p><h2>아직 확인할 항목</h2><ul id="remaining">{items.map(([,title]) => <li>{title}</li>)}</ul>
<div class="actions"><button type="button" id="print">준비 목록 인쇄하기</button><button type="reset">체크 초기화</button></div>
</form>
<h2>자료를 어디에 제출하나요?</h2><p>소득·재산 증빙은 국세청 공식 신청 절차에서 요구하는 경우에 제출하세요. 이 사이트에는 주민등록번호·계좌번호·서류 원본을 보내지 마세요.</p>
<p><a class="btn-tool" href={SOURCES.application}>국세청 신청 방법 확인하기</a></p>
<p class="meta">확인 범위: 2025년 소득분의 신청 일정과 준비 항목. 개인별 필수 서류·수급 여부 전체를 판단하지 않습니다.</p>
<noscript><p>체크와 인쇄는 브라우저 기본 기능으로도 이용할 수 있습니다. 확인 개수와 남은 목록의 자동 갱신에는 JavaScript가 필요합니다.</p></noscript>
</BaseLayout>
<script>
const form = document.querySelector<HTMLFormElement>('#prepare-form')!;
const checks = Array.from(form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
function update() {
 const missing = checks.filter(c => !c.checked);
 document.getElementById('progress')!.textContent = `확인한 항목 ${checks.length - missing.length} / ${checks.length} — 자격 심사 결과가 아닙니다.`;
 document.getElementById('remaining')!.replaceChildren(...missing.map(c => {const li=document.createElement('li');li.textContent=c.dataset.title!;return li;}));
}
form.addEventListener('change',update);
form.addEventListener('reset',()=>setTimeout(update,0));
document.getElementById('print')!.addEventListener('click',()=>window.print());
update();
</script>
<style>
.prepare-item { padding: 18px 0; border-bottom: 1px solid var(--border); }
.prepare-item label { display: flex; align-items: baseline; gap: 10px; cursor: pointer; }
.prepare-item input { flex: none; } .prepare-item p { margin: 8px 0 0; color: var(--muted); }
.actions { display: flex; flex-wrap: wrap; gap: 12px; } button { background: var(--surface); border: 1px solid var(--border); padding: 12px; border-radius: var(--radius); color: var(--text); font: inherit; cursor: pointer; }
@media print { :global(.site-header), :global(.site-footer), .actions, .btn-tool { display: none; } .prepare-item { break-inside: avoid; } }
</style>
