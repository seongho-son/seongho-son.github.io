---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import ServiceList from '../../../components/ServiceList.astro';
import { sidoGroups, topThemes, lifecycleCounts, josa, SOURCE, FETCHED_AT } from '../../../lib/regions';

export function getStaticPaths() {
  return sidoGroups.map((g) => ({ params: { sido: g.slug }, props: { group: g } }));
}

const { group } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const all = [...group.wideServices, ...group.sigungus.flatMap((s) => s.services)];
const themes = topThemes(all);
const life = lifecycleCounts(all).slice(0, 4);
const withPage = group.sigungus.filter((s) => s.hasPage);
const withoutPage = group.sigungus.filter((s) => !s.hasPage);
const wideTop = [...group.wideServices].sort((a, b) => b.views - a.views).slice(0, 15);
---
<BaseLayout
  title={`${group.short} 지원금 목록 — ${group.name} 지자체 복지서비스`}
  description={`${group.name}에서 시행하는 지자체 복지서비스 ${group.total.toLocaleString('ko-KR')}건을 시군구별로 정리했습니다. ${group.short} 지역 지원금·수당·바우처를 한 곳에서 찾아보세요.`}
  wide
>
  <p class="crumb"><a href={`${base}/regions`}>지역별 지원금</a> › {group.short}</p>
  <h1>{group.short} 지역 지원금 목록</h1>
  <p class="lead">
    {group.name}에 등록된 지자체 복지서비스는 <strong>{group.total.toLocaleString('ko-KR')}건</strong>입니다.
    {group.sigungus.length > 0 && <> 시군구 <strong>{group.sigungus.length}곳</strong>의 자체 사업과 </>}
    광역자치단체가 직접 시행하는 사업 <strong>{group.wideServices.length.toLocaleString('ko-KR')}건</strong>이 포함됩니다.
    {themes.length > 0 && <> 분야는 <strong>{themes.join(' · ')}</strong> 순으로 많습니다.</>}
  </p>

  <Disclaimer source={`${SOURCE} (공공데이터포털 오픈API)`} updated={FETCHED_AT} subject="이 목록은" />

  {life.length > 0 && (
    <p class="disclaimer">
      생애주기별 사업 수: {life.map(([k, v]) => `${k} ${v}건`).join(' · ')}
      (한 사업이 여러 주기에 걸칠 수 있어 합계는 전체 건수와 다릅니다.)
    </p>
  )}

  <div class="ad-slot" aria-hidden="true"></div>

  {group.sigungus.length > 0 && (
    <>
      <h2>시·군·구별 등록 사업 수</h2>
      <div class="sgg-grid">
        {group.sigungus.map((s) =>
          s.hasPage ? (
            <a class="sgg" href={`${base}/regions/${group.slug}/${s.slug}`}>
              {s.name} <span>{s.services.length}</span>
            </a>
          ) : (
            <div class="sgg static">
              {s.name} <span>{s.services.length}</span>
            </div>
          )
        )}
      </div>
      <p class="disclaimer">
        {withPage.length > 0
          ? '이름을 누르면 해당 시·군·구의 사업 목록을 볼 수 있습니다. '
          : '시·군·구별 상세 목록은 준비 중입니다. '}
        각 지역의 개별 사업은 <a href="https://www.bokjiro.go.kr" target="_blank" rel="noopener">복지로</a>에서
        지역을 선택해 바로 확인할 수 있습니다.
      </p>
    </>
  )}

  {wideTop.length > 0 && (
    <>
      <h2>{group.short}{josa(group.short, '이', '가')} 직접 시행하는 사업</h2>
      <p>
        시군구와 무관하게 {group.name} 전역 주민이 대상인 사업입니다.
        조회가 많은 순으로 {wideTop.length}건을 먼저 보여드립니다.
      </p>
      <ServiceList services={wideTop} />
      {group.wideServices.length > wideTop.length && (
        <p class="disclaimer" style="margin-top:12px;">
          이 외 {(group.wideServices.length - wideTop.length).toLocaleString('ko-KR')}건이 더 있습니다.
          전체 목록은 <a href="https://www.bokjiro.go.kr" target="_blank" rel="noopener">복지로</a>에서 확인하세요.
        </p>
      )}
    </>
  )}

  <div class="ad-slot" aria-hidden="true"></div>

  <h2>전국 공통 제도도 함께 확인하세요</h2>
  <p>
    아래는 거주 지역과 무관하게 요건만 맞으면 받을 수 있는 제도입니다. 예상 수령액을 먼저 계산해 보고,
    위 지역 사업으로 추가로 받을 수 있는 것을 찾는 순서를 권합니다.
  </p>
  <ul>
    <li><a href={`${base}/tools/labor-tax-credit`}>근로장려금 계산기</a> · <a href={`${base}/tools/child-tax-credit`}>자녀장려금 계산기</a></li>
    <li><a href={`${base}/tools/median-income`}>기준 중위소득 계산기</a> — 지역 사업 대부분이 이 기준을 씁니다</li>
    <li><a href={`${base}/guides/housing-benefit`}>주거급여</a> · <a href={`${base}/guides/energy-voucher`}>에너지바우처</a></li>
  </ul>

  <style>
    .crumb { font-size: 13px; color: var(--muted); margin: 0 0 8px; }
    .sgg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 8px;
      margin: 14px 0;
    }
    .sgg {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      text-decoration: none;
      font-size: 14px;
      background: var(--surface);
    }
    .sgg:hover { border-color: var(--accent); }
    .sgg.static { color: var(--muted); }
    .sgg span { color: var(--muted); font-size: 13px; }
  </style>

  <blockquote>
    지원 대상·금액·신청 기간은 지자체 공고에 따라 바뀝니다. 신청 전 반드시
    <strong>복지로</strong> 또는 관할 주민센터에서 최신 내용을 확인하세요.
    <br />
    👉 <a href="https://www.bokjiro.go.kr" target="_blank" rel="noopener">복지로에서 확인하기</a>
  </blockquote>
</BaseLayout>
