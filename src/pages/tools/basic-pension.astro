---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import {
  BP_YEAR,
  BP_SOURCE,
  BP_CONFIRMED_AT,
  SELECTION_SINGLE,
  SELECTION_COUPLE,
  MAX_PENSION_SINGLE,
  MAX_PENSION_COUPLE,
} from '../../lib/basic-pension';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const won = (n: number) => Math.round(n).toLocaleString('ko-KR');
---
<BaseLayout
  title="기초연금 계산기 — 나는 대상일까, 월 얼마 받을까"
  description="만 65세 이상 가구형태와 월 소득인정액만 넣으면 기초연금 대상 가능성과 예상 월 최대 수령액을 바로 확인합니다. 2025년 선정기준액 기준. 개인정보 없이 브라우저에서 자가진단."
>
  <h1>기초연금 계산기</h1>
  <p class="lead">
    가구형태와 <strong>월 소득인정액</strong>만 넣으면 <strong>기초연금 대상 가능성</strong>과
    <strong>예상 월 최대 수령액</strong>을 계산합니다. 개인정보는 받지 않고, 계산은 브라우저 안에서만
    이루어집니다. 결과는 참고용 추정이며, 실제 대상·금액은 심사 결과에 따라 다릅니다.
  </p>

  <Disclaimer source={`${BP_SOURCE} (${BP_YEAR}년 기준)`} updated={BP_CONFIRMED_AT} />

  <p class="notice-box">
    <strong>소득인정액 = 월급만이 아니라 재산까지 소득으로 환산해 더한 금액</strong>입니다.
    기초연금 심사는 이 금액으로 하기 때문에, 월급이 낮아도 재산이 많으면 넘을 수 있습니다.
    내 소득인정액을 정확히 모른다면 <a href="https://basicpension.mohw.go.kr" target="_blank" rel="noopener">기초연금 공식 홈페이지</a>나
    <a href="https://www.bokjiro.go.kr" target="_blank" rel="noopener">복지로</a> 모의계산으로 먼저 확인하세요.
  </p>

  <div class="calc">
    <label for="htype">가구형태</label>
    <select id="htype">
      <option value="single" selected>단독가구 (혼자 받음)</option>
      <option value="couple">부부가구 (부부 둘 다 만 65세 이상, 함께 받음)</option>
    </select>
    <p class="disclaimer" style="margin-top:6px;">
      부부가 함께 받으면 각자 금액이 <strong>20% 줄어듭니다</strong>. 배우자가 만 65세 미만이거나
      한 사람만 신청하면 단독가구로 계산하세요.
    </p>

    <label for="income">월 소득인정액 (원)</label>
    <input id="income" type="text" inputmode="numeric" data-money placeholder="예: 1,200,000" />
    <p class="disclaimer" style="margin-top:6px;">
      단순 월급이 아니라 재산까지 환산해 더한 금액입니다. 정확한 값은 위 공식 모의계산을 이용하고,
      여기서는 대략적인 위치를 가늠하는 용도로 넣으세요.
    </p>

    <button id="calcBtn">기초연금 대상·예상액 계산하기</button>

    <p id="errOut" class="calc-error hidden" role="alert"></p>

    <div id="result" class="result hidden">
      <div id="verdictOut" class="verdict">–</div>
      <div>예상 월 최대 수령액 (가구 기준)</div>
      <div class="total" id="totalOut">–</div>
      <div class="total-sub" id="subOut">참고용 추정</div>
      <table>
        <tbody>
          <tr><td>가구형태</td><td id="typeOut">–</td></tr>
          <tr><td>{BP_YEAR}년 선정기준액(월 소득인정액 상한)</td><td id="thrOut">–</td></tr>
          <tr><td>입력한 월 소득인정액</td><td id="incOut">–</td></tr>
          <tr><td id="gapLabel">기준까지 남은 여유</td><td id="gapOut">–</td></tr>
        </tbody>
      </table>
      <p class="disclaimer" id="reduceNote"></p>
    </div>
  </div>

  <style>
    .calc-error { color: #b42318; font-size: 14px; margin-top: 10px; font-weight: 600; }
    .calc-error.hidden { display: none; }
    .verdict { font-size: 18px; font-weight: 700; margin-bottom: 12px; }
    .verdict.ok { color: #067647; }
    .verdict.no { color: #b42318; }
    .total-sub { font-size: 13px; color: var(--muted); margin-top: 2px; }
    .notice-box {
      border: 1px solid var(--border, #ddd);
      border-left: 4px solid #b54708;
      border-radius: 6px;
      padding: 12px 14px;
      margin: 16px 0;
      font-size: 14px;
    }
    select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border, #ddd);
      border-radius: 6px;
      font-size: 16px;
      background: #fff;
    }
  </style>

  <div class="ad-slot" aria-hidden="true"></div>

  <h2>기초연금, 누가 받나?</h2>
  <ul>
    <li><strong>만 65세 이상</strong>, 대한민국 국적, 국내 거주</li>
    <li>월 <strong>소득인정액</strong>이 정부가 정한 <strong>선정기준액 이하</strong> — 소득 하위 70%가 대상입니다</li>
  </ul>

  <h2>{BP_YEAR}년 선정기준액과 월 최대 금액</h2>
  <table>
    <thead>
      <tr><th>가구형태</th><th>선정기준액(이하)</th><th>월 최대 수령액</th></tr>
    </thead>
    <tbody>
      <tr><td>단독가구</td><td>{won(SELECTION_SINGLE)}원</td><td>{won(MAX_PENSION_SINGLE)}원</td></tr>
      <tr><td>부부가구</td><td>{won(SELECTION_COUPLE)}원</td><td>{won(MAX_PENSION_COUPLE)}원 (부부 합산)</td></tr>
    </tbody>
  </table>
  <p class="disclaimer">
    {BP_YEAR}년 기준, 출처: {BP_SOURCE}. 최종 확인 {BP_CONFIRMED_AT}. 금액은 매년 조정되며,
    <strong>{BP_YEAR + 1}년 고시가 확정되면 달라질 수 있습니다.</strong>
    정확한 최신 금액은 <a href="https://basicpension.mohw.go.kr" target="_blank" rel="noopener">기초연금 공식 홈페이지</a>에서 확인하세요.
  </p>

  <h2>왜 '최대'라고 하나 — 줄어들 수 있는 경우</h2>
  <ul>
    <li><strong>부부가 함께 받으면</strong> 각자 20% 감액됩니다(위 부부 합산 금액에 이미 반영).</li>
    <li><strong>소득인정액이 선정기준액에 가까우면</strong> 탈락자와 금액이 역전되지 않도록 일부 감액될 수 있습니다(소득역전방지 감액).</li>
    <li><strong>국민연금을 많이 받으면</strong> 기초연금이 일부 줄 수 있습니다(연계 감액). 다만 국민연금을 받는다고 기초연금을 아예 못 받는 것은 아닙니다.</li>
  </ul>

  <div class="ad-slot" aria-hidden="true"></div>

  <h2>자주 묻는 것</h2>
  <p><strong>국민연금을 받고 있는데 기초연금도 되나요?</strong><br />
    됩니다. 다만 국민연금 수령액이 많으면 기초연금이 일부 줄 수 있습니다(요건 충족 시 지급하며, 실제 금액은 심사 결과에 따라 다릅니다).</p>
  <p><strong>집이 있으면 못 받나요?</strong><br />
    집·예금·자동차 같은 재산은 소득인정액으로 환산해 함께 봅니다. 재산이 있어도 소득인정액이 선정기준액 이하면 대상이 될 수 있습니다.</p>
  <p><strong>언제 신청하나요?</strong><br />
    만 65세 생일이 속한 달의 <strong>1개월 전부터</strong> 신청할 수 있습니다.</p>

  <blockquote>
    정확한 대상 여부와 신청은 <strong>주소지 주민센터·국민연금공단 지사·복지로</strong>에서 하셔야 합니다.
    이 계산기의 결과는 참고용 추정입니다.
    <br />
    👉 <a href="https://www.bokjiro.go.kr" target="_blank" rel="noopener">복지로에서 모의계산·신청하기</a>
  </blockquote>

  <p style="margin-top:24px;">
    관련 정보 →
    <a href={`${base}/guides/basic-pension`}>기초연금 자격·금액·신청 총정리</a> ·
    <a href={`${base}/guides/income-recognition-amount`}>소득인정액이란?</a> ·
    <a href={`${base}/tools/median-income`}>기준 중위소득 계산기</a>
  </p>

  <script>
  import { initMoneyInputs, moneyRaw, moneyValue } from '../../lib/money.js';
  import { estimateBasicPension } from '../../lib/basic-pension';

  const won = (n) => Math.round(n).toLocaleString('ko-KR') + '원';

  function run() {
    const type = document.getElementById('htype').value;
    const incomeRaw = moneyRaw('income');
    const income = moneyValue('income');
    const box = document.getElementById('result');
    const err = document.getElementById('errOut');

    const fail = (msg) => {
      err.textContent = msg;
      err.classList.remove('hidden');
      box.classList.add('hidden');
    };

    if (incomeRaw === '') return fail('월 소득인정액을 입력해 주세요.');
    if (isNaN(income)) return fail('월 소득인정액은 숫자로 입력해 주세요.');
    if (income < 0) return fail('월 소득인정액은 0원 이상이어야 합니다.');
    err.classList.add('hidden');

    const r = estimateBasicPension(type, income);
    const typeLabel = type === 'single' ? '단독가구' : '부부가구 (각자 20% 감액)';

    const verdict = document.getElementById('verdictOut');
    if (r.eligible) {
      verdict.textContent = '✅ 소득인정액 기준으로는 대상이 될 수 있습니다';
      verdict.className = 'verdict ok';
    } else {
      verdict.textContent = '❌ 소득인정액이 선정기준액을 넘어 대상이 어렵습니다';
      verdict.className = 'verdict no';
    }

    document.getElementById('totalOut').textContent = r.eligible ? won(r.maxMonthly) : '0원';
    document.getElementById('subOut').textContent = r.eligible
      ? '참고용 추정 · 감액되면 이보다 적을 수 있습니다'
      : '선정기준액 초과 (참고용 추정)';
    document.getElementById('typeOut').textContent = typeLabel;
    document.getElementById('thrOut').textContent = won(r.threshold);
    document.getElementById('incOut').textContent = won(income);

    const gapLabel = document.getElementById('gapLabel');
    const gapOut = document.getElementById('gapOut');
    if (r.gap >= 0) {
      gapLabel.textContent = '기준까지 남은 여유';
      gapOut.textContent = won(r.gap);
    } else {
      gapLabel.textContent = '기준을 초과한 금액';
      gapOut.textContent = won(-r.gap);
    }

    document.getElementById('reduceNote').innerHTML = r.eligible
      ? '※ 부부 감액·소득역전방지 감액·국민연금 연계 감액으로 실제 수령액은 위 금액보다 <strong>적을 수 있습니다.</strong> 정확한 금액은 기초연금 공식 모의계산에서 확인하세요.'
      : '※ 소득인정액은 재산까지 환산해 더한 값이라, 공식 모의계산 결과는 달라질 수 있습니다. 경계에 가깝다면 실제 신청·상담을 받아보세요.';

    box.classList.remove('hidden');
  }

  initMoneyInputs();
  document.getElementById('calcBtn').addEventListener('click', run);
  document.getElementById('income').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') run();
  });
</script>
</BaseLayout>
