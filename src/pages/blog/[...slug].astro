---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { post } = Astro.props;
const { Content } = await post.render();

const fmt = (d) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <article>
    <span class="badge">{post.data.category}</span>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {fmt(post.data.pubDate)}
      {post.data.updatedDate && ` · 수정 ${fmt(post.data.updatedDate)}`}
    </p>

    {/* 상단 광고 — 제목 바로 아래, 가시성 최상 */}
    <div class="ad-slot" aria-hidden="true"></div>

    <Content />

    {post.data.relatedTool && (
      <div class="cta-box">
        <a href={`${base}${post.data.relatedTool}`}>👉 관련 계산기로 내게 해당하는 금액 직접 계산해보기</a>
      </div>
    )}

    <aside class="post-disclaimer">
      <p>
        본 글은 공개된 자료를 바탕으로 한 참고용 정보이며, 실제 지급 여부·금액은 관계 기관의
        심사 결과에 따라 달라집니다. 제도의 기준과 금액은 수시로 변경될 수 있으니 신청 전
        반드시 공식 사이트에서 최신 내용을 확인하세요. <strong>얼마받지는 정부기관이 아닌
        민간 정보 제공 사이트</strong>이며, 신청을 대행하지 않습니다.
      </p>
    </aside>
  </article>
</BaseLayout>
