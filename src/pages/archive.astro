---
import { getCollection } from 'astro:content';
import { isCurrentGuide } from '../lib/editorial.js';
import { RETIRED_TOOLS } from '../lib/retired-tools.js';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('blog')).filter(p => !isCurrentGuide(p.slug));
---
<BaseLayout title="과거 자료와 종료한 도구" description="운영 범위를 장려금 신청 준비로 좁히면서 최신 갱신을 종료한 자료를 구분해 보관합니다." noindex>
<h1>과거 자료와 종료한 도구</h1><p class="lead">현재 신청 안내와 구분해 보관하는 자료입니다.</p>
<p>2026년 9월 21일부터 근로·자녀장려금에 집중합니다. 아래 글은 기존 작성 시점의 자료이며 이후 제도 변경을 계속 반영하지 않습니다. 최신 대상·금액·신청일은 소관 기관에서 확인하세요. 광고를 게재하지 않습니다.</p>
<h2>종료한 계산기</h2><ul>{Object.entries(RETIRED_TOOLS).map(([slug,t]) => <li><a href={`/tools/${slug}/`}>{t.title}: 종료 이유와 공식 확인 경로</a></li>)}</ul>
<h2>과거 안내 글</h2><ul>{posts.map(p => <li><a href={`/guides/${p.slug}/`}>{p.data.title}</a></li>)}</ul>
<p><a href="/guides/">현재 장려금 안내 보기</a> · <a href="/editorial/">작성 기준과 정정 내역</a></p>
</BaseLayout>
