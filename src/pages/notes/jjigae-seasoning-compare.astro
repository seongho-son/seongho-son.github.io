---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notes, findRecipe, cell, amount } from '../../data/notes.js';

const note = notes.find(item => item.slug === 'jjigae-seasoning-compare');
const others = notes.filter(item => item.slug !== note.slug);
const measuring = notes.find(item => item.slug === 'paper-cup-measuring');

const kimchi = findRecipe('/recipes/kimchi-jjigae/');
const doenjang = findRecipe('/recipes/ryu-doenjang-jjigae/');
const sundubu = findRecipe('/recipes/ryu-spam-sundubu/');
const jjageuli = findRecipe('/recipes/aeri-potato-spam-stew/');
const dak = findRecipe('/recipes/paik-dakbokkeumtang/');

const rows = [
  { recipe: kimchi, label: '김치찌개' },
  { recipe: doenjang, label: '차돌 된장찌개' },
  { recipe: sundubu, label: '스팸순두부찌개' },
  { recipe: jjageuli, label: '감자짜글이' },
  { recipe: dak, label: '닭볶음탕' },
].filter(row => row.recipe);

const columns = [
  { head: '물', pattern: /^물/ },
  { head: '기름', pattern: /식용유|참기름|들기름/ },
  { head: '장', pattern: /된장|쌈장|고추장/ },
  { head: '고춧가루', pattern: /고춧가루/ },
  { head: '간장·소스', pattern: /간장|굴소스/ },
  { head: '젓갈·소금·식초', pattern: /새우젓|소금|식초/ },
  { head: '단맛', pattern: /설탕/ },
];
const link = row => row.recipe.recipeMeta.path;
---
<BaseLayout title={note.title} description={note.description} type="article">
  <article class="post note-page">
    <header class="post-header">
      <span class="category">레시피 비교·계량 노트</span>
      <h1>{note.title}</h1>
      <p class="byline">편집 정리 · 레시피 나와라 뚝딱</p>
    </header>
    <div class="post-content">
      <p>찌개는 재료가 달라도 냄비에 물을 붓고 장과 고춧가루로 간을 맞추는 흐름이 비슷해 보여요. 그런데 이 블로그에 정리한 찌개 레시피들을 나란히 놓고 보면 물의 양, 기름을 쓰는지, 간장을 언제 넣는지가 꽤 달라요. 이 노트는 각 레시피의 1–2인분 재료표에서 물과 양념 줄만 뽑아 한 표에 모으고, 표에서 읽히는 차이를 정리한 글이에요.</p>
      <p class="note-disclaimer">원작자들의 영상 설명란을 바탕으로 만든 사이트 레시피 표를 비교한 <strong>편집 정리</strong>예요. 다섯 가지를 직접 끓여 비교한 결과가 아니라, 표와 조리 순서에서 확인되는 차이만 적었어요. 정확한 분량과 순서는 각 레시피 글에서 확인해주세요.</p>

      <h2 id="table">1–2인분 물과 양념 한눈에 보기</h2>
      <p>주재료(김치, 고기, 두부, 채소)는 빼고 국물과 간을 만드는 재료만 모았어요. 표의 숫자는 각 레시피 글의 재료표에서 그대로 가져온 값이에요. 칸이 비어 있으면(—) 그 레시피에는 해당 재료가 없다는 뜻이에요.</p>
      <div class="note-table-wrap" role="region" aria-label="찌개 다섯 가지의 1–2인분 물과 양념 비교표" tabindex="0">
        <table class="note-table">
          <thead><tr><th scope="col">레시피</th>{columns.map(col => <th scope="col">{col.head}</th>)}</tr></thead>
          <tbody>
            {rows.map(row => <tr><th scope="row"><a href={link(row)}>{row.label}</a></th>{columns.map(col => <td>{cell(row.recipe, col.pattern)}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p class="note-caption">표가 화면보다 넓으면 옆으로 밀어서 볼 수 있어요. 숟가락 기준은 레시피마다 조금씩 달라요. 아래에 각 글의 계량 안내를 그대로 옮겨뒀어요.</p>
      <ul class="note-list">
        {rows.map(row => <li><a href={link(row)}>{row.label}</a>: {row.recipe.measureNote}</li>)}
      </ul>

      <h2>기름으로 시작하는 건 스팸순두부찌개뿐이에요</h2>
      <p>다섯 가지 중 냄비에 기름부터 두르는 건 <a href={sundubu.recipeMeta.path}>스팸순두부찌개</a> 하나예요. 식용유를 {amount(sundubu, '식용유')} 두르고 으깬 스팸을 노릇하게 볶은 뒤, 불을 끄고 고춧가루 {amount(sundubu, '고춧가루')}를 잔열로 저어 고추기름을 내요. 고춧가루 양은 닭볶음탕과 함께 많은 편인데, 국물에 바로 풀지 않고 기름에 먼저 볶는 구조라는 점이 다른 찌개와 가장 크게 달라요. 원본은 기름 양을 "냄비에 세 바퀴"로 안내해서, 레시피 글에서도 임의로 큰술로 바꾸지 않았어요.</p>
      <p>나머지는 모두 물에서 출발해요. <a href={kimchi.recipeMeta.path}>김치찌개</a>는 김치를 볶지 않고 돼지고기와 물, 새우젓을 먼저 끓여요. <a href={doenjang.recipeMeta.path}>차돌 된장찌개</a>는 물에 채소와 장을 한꺼번에 넣고 끓이다가 고기를 나중에 넣어요. <a href={jjageuli.recipeMeta.path}>감자짜글이</a>는 감자·양파·햄에 양념을 먼저 버무린 뒤 물을 붓고, <a href={dak.recipeMeta.path}>닭볶음탕</a>은 데친 닭을 새 물에 넣고 끓여요. 기름 없이 시작하는 찌개가 넷이나 된다는 점은 표에서 바로 보이는 차이예요.</p>

      <h2>물의 양이 국물의 성격을 정해요</h2>
      <p>1–2인분 물만 비교하면 김치찌개가 {amount(kimchi, '물')}로 가장 많고, 차돌 된장찌개가 {amount(doenjang, '물')}, 닭볶음탕이 {amount(dak, '물')}예요. 스팸순두부찌개({amount(sundubu, '물')})와 감자짜글이({amount(jjageuli, '물')})는 물이 적은 편이에요.</p>
      <p>물이 적은 두 레시피는 이유가 있어요. 순두부찌개는 채소와 순두부에서 물이 나와서 처음 물이 많지 않다고 원본이 설명하고, 짜글이는 밥에 얹어 먹는 자작한 요리라서 국물을 넉넉히 잡지 않아요. 반대로 김치찌개는 고기를 오래 끓이는 동안 물이 졸아드는 걸 전제로 해요. 레시피 글에서는 줄어든 만큼만 처음 높이까지 채우라고 안내하는데, 처음 분량을 다시 붓는 게 아니라는 점이 헷갈리기 쉬워요.</p>

      <h2>장을 어떻게 섞는지도 달라요</h2>
      <p>장을 두 가지 섞는 레시피가 둘이에요. 차돌 된장찌개는 된장 {amount(doenjang, '된장')}에 쌈장 {amount(doenjang, '쌈장')}을 더해요. 된장 하나로만 간을 잡지 않는 구성이고, 숟가락에 듬뿍 담는 기준이에요. 여기에 식초 {amount(doenjang, '식초')}를 넣는데, 국물이 끓기 시작해 중불로 줄인 뒤에 넣는 순서예요. 찌개에 식초가 들어가는 건 다섯 가지 중 이 레시피뿐이에요.</p>
      <p>감자짜글이는 고추장 {amount(jjageuli, '고추장')}과 된장 {amount(jjageuli, '된장')}을 조금씩 쓰고, 빨간 색과 매운맛은 고춧가루 {amount(jjageuli, '고춧가루')}로 내요. 장이 주인공이라기보다 고춧가루 양념에 깊이를 보태는 정도의 양이에요. 김치찌개는 장류를 아예 쓰지 않고 국간장 {amount(kimchi, '국간장')}과 새우젓 {amount(kimchi, '새우젓')}으로 간을 해요. 신김치의 간과 신맛에 기대는 구성이라고 볼 수 있어요.</p>

      <h2>간장 계열은 나눠 넣는 쪽이 안전해요</h2>
      <p>간장이 가장 많이 들어가는 건 닭볶음탕이에요. 진간장 {amount(dak, '진간장')}를 빨간 양념과 함께 넣는데, 레시피 글의 팁에서 원본 분량을 그대로 넣고 짰다는 시청자 경험을 소개하고 일부를 남겨뒀다가 간을 보며 더하라고 권해요. 국물이 졸수록 짠맛도 진해지기 때문이에요.</p>
      <p>스팸순두부찌개는 간장 {amount(sundubu, '간장')}과 굴소스 {amount(sundubu, '굴소스')}를 써요. 햄 자체에도 간이 있으니 짠맛 재료가 겹친다는 점을 염두에 두면 좋아요. 원본은 재료를 한쪽으로 밀고 빈 곳에서 간장을 먼저 끓인 뒤 섞는 방식이에요. 김치찌개의 국간장도 처음부터 다 넣기보다 일부를 남겼다가 마지막에 맞추라고 안내해요. 세 레시피 모두 "표의 간장은 최대치, 마지막 간은 직접"이라고 생각하면 실패가 줄어요.</p>

      <h2>설탕은 들어가는 시점을 보세요</h2>
      <p>단맛 재료가 있는 건 세 가지예요. 닭볶음탕은 황설탕 {amount(dak, '황설탕')}을 맨 처음 닭·감자와 함께 넣고, 빨간 양념은 끓기 시작하고 약 15분 뒤에 넣어요. 스팸순두부찌개는 설탕 {amount(sundubu, '설탕')}을 마늘·대파와 같이 볶는 단계에서 넣고, 감자짜글이는 설탕 {amount(jjageuli, '설탕')}을 다른 양념과 처음부터 버무려요. 김치찌개와 된장찌개에는 설탕이 없어요.</p>

      <h2>이럴 때 이 레시피를 골라보세요</h2>
      <ul class="note-list">
        <li>국물을 넉넉히 떠먹고 싶다면 물이 가장 많은 <a href={kimchi.recipeMeta.path}>김치찌개</a>예요. 장이 없어도 신김치와 새우젓, 국간장만 있으면 돼요.</li>
        <li>집에 된장과 쌈장이 같이 있다면 <a href={doenjang.recipeMeta.path}>차돌 된장찌개</a>. 볶는 과정 없이 한 냄비에 넣고 끓이는 순서라 손이 덜 가요.</li>
        <li>매콤하고 진한 국물을 원한다면 고추기름을 내는 <a href={sundubu.recipeMeta.path}>스팸순두부찌개</a>. 대신 짠맛 재료가 많으니 간을 보면서 졸여주세요.</li>
        <li>밥에 비벼 먹을 한 냄비라면 <a href={jjageuli.recipeMeta.path}>감자짜글이</a>. 물이 적고 감자를 얇게 썰어 익히는 시간이 짧아요.</li>
        <li>주말에 넉넉히 끓일 메인 요리라면 <a href={dak.recipeMeta.path}>닭볶음탕</a>. 양념을 두 번에 나눠 넣는 순서를 지키는 게 핵심이에요.</li>
      </ul>

      <h2>3–4인분으로 늘릴 때 주의할 점</h2>
      <p>표의 3–4인분 열은 대부분 1–2인분의 두 배예요. 하지만 분량이 두 배라고 끓이는 시간까지 두 배로 늘리지는 않아요. 물이 많아지면 끓어오르는 데 시간이 더 걸리고, 넓은 냄비에서는 물이 더 빨리 졸기도 해요. 시간은 참고로만 보고 고기와 감자가 충분히 익었는지, 국물 높이가 어떤지를 기준으로 판단해주세요. 스팸순두부찌개처럼 기름으로 시작하는 레시피는 레시피 글에서 같은 냄비로 두 번 나눠 끓이는 방법을 권해요. 종이컵과 숟가락 기준은 <a href={measuring.path}>{measuring.title}</a>에 따로 정리했어요.</p>

      <aside class="source-note" aria-label="노트 출처">
        <p><strong>이 노트의 근거</strong><br />{rows.map((row, i) => <>{i > 0 && ' · '}<a href={link(row)}>{row.label}</a></>)}</p>
        <p>각 레시피 글은 원작자의 영상 설명란·고정 댓글을 기준으로 정리했고, 이 노트는 그 재료표를 다시 비교한 편집 정리예요. 원본 배합은 바꾸지 않았고, 관찰과 고르는 기준은 편집자가 덧붙였어요. 직접 조리 비교는 하지 않았으며 원작자와 제휴 관계는 없습니다.</p>
      </aside>
      <nav class="related-recipes" aria-labelledby="other-notes">
        <h2 id="other-notes">다른 비교·계량 노트</h2>
        <ul>{others.map(item => <li><a href={item.path}>{item.title}</a></li>)}</ul>
      </nav>
    </div>
  </article>
</BaseLayout>
