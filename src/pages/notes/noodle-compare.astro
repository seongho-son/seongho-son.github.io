---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notes, findRecipe, cell, amount } from '../../data/notes.js';

const note = notes.find(item => item.slug === 'noodle-compare');
const others = notes.filter(item => item.slug !== note.slug);
const measuring = notes.find(item => item.slug === 'paper-cup-measuring');

const bibim = findRecipe('/recipes/paik-bibim-guksu/');
const janchi = findRecipe('/recipes/paik-janchi-guksu/');
const ryu = findRecipe('/recipes/ryu-soy-sauce-noodles/');
const udong = findRecipe('/recipes/paik-bokkeum-udong/');

const rows = [
  { recipe: bibim, label: '고추장 비빔국수' },
  { recipe: janchi, label: '잔치국수' },
  { recipe: ryu, label: '설마간장 비빔국수' },
  { recipe: udong, label: '볶음우동' },
].filter(row => row.recipe);

const columns = [
  { head: '면', pattern: /면$/ },
  { head: '간장', pattern: /간장/ },
  { head: '고추장·고춧가루', pattern: /고추장|고춧가루/ },
  { head: '식초', pattern: /식초/ },
  { head: '단맛', pattern: /설탕/ },
  { head: '기름', pattern: /참기름|식용유/ },
  { head: '마늘·깨', pattern: /마늘|깨/ },
  { head: '물', pattern: /^물|국물용 물/ },
];
const link = row => row.recipe.recipeMeta.path;
---
<BaseLayout title={note.title} description={note.description} type="article">
  <article class="post note-page">
    <header class="post-header">
      <span class="category">레시피 비교·계량 노트</span>
      <h1>{note.title}</h1>
      <p class="byline">편집 정리 · 레시피 나와라 뚝딱</p>
    </header>
    <div class="post-content">
      <p>국수가 당기는 날, 막상 무엇을 만들지 고르려면 레시피를 하나씩 열어봐야 해요. 이 노트는 블로그에 정리한 국수 레시피 세 가지와 볶음우동 하나를 나란히 놓고, 양념이 무엇으로 이뤄져 있는지와 만드는 방식이 어떻게 다른지를 정리했어요. 냉장고에 있는 장과 그날 먹고 싶은 온도에 맞춰 고르는 데 쓰면 좋아요.</p>
      <p class="note-disclaimer">원작자들의 영상 설명란을 바탕으로 만든 사이트 레시피 표를 비교한 <strong>편집 정리</strong>예요. 네 가지를 직접 만들어 비교한 결과가 아니라, 재료표와 조리 순서에서 확인되는 차이만 적었어요. 정확한 분량과 순서는 각 레시피 글에서 확인해주세요.</p>

      <h2 id="table">1–2인분 양념 구성 한눈에 보기</h2>
      <p>면과 양념에 들어가는 재료만 모았어요. 김치, 채소, 고기, 달걀 같은 건더기와 마지막에 올리는 고명은 뺐어요. 표의 숫자는 각 레시피 글의 1–2인분 재료표에서 그대로 가져왔고, 빈칸(—)은 그 재료가 들어가지 않는다는 뜻이에요.</p>
      <div class="note-table-wrap" role="region" aria-label="국수 네 가지의 1–2인분 양념 구성 비교표" tabindex="0">
        <table class="note-table">
          <thead><tr><th scope="col">레시피</th>{columns.map(col => <th scope="col">{col.head}</th>)}</tr></thead>
          <tbody>
            {rows.map(row => <tr><th scope="row"><a href={link(row)}>{row.label}</a></th>{columns.map(col => <td>{cell(row.recipe, col.pattern)}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p class="note-caption">표가 화면보다 넓으면 옆으로 밀어서 볼 수 있어요. 잔치국수의 간장은 원본 컵의 용량이 분명하지 않아 함께 적힌 무게로, 볶음우동은 숟가락 단위 옆에 원본 무게를 괄호로 적었어요.</p>

      <h2>간장은 네 가지 모두에 들어가요</h2>
      <p>면을 빼면 네 레시피의 양념 칸이 빠짐없이 채워진 건 간장 하나예요. 다만 역할이 다르답니다. <a href={ryu.recipeMeta.path}>설마간장 비빔국수</a>는 양조간장 {amount(ryu, '양조간장')}이 양념의 중심이고, {amount(ryu, '참기름') === amount(ryu, '양조간장') ? '같은 양의 ' : ''}참기름 {amount(ryu, '참기름')}과 설탕 {amount(ryu, '설탕')}, 다진 마늘 {amount(ryu, '다진 마늘')}이 더해지는 단순한 구성이에요. 여기에 양념을 씻어낸 김치 {amount(ryu, '익은 김치 또는 묵은지')}를 올리니 김치에서도 간과 신맛이 더해져요.</p>
      <p><a href={bibim.recipeMeta.path}>고추장 비빔국수</a>에서 진간장은 {amount(bibim, '진간장')}만 들어가는 보조 역할이에요. 고추장 {amount(bibim, '고추장')}과 양조식초 {amount(bibim, '양조식초')}, 황설탕 {amount(bibim, '황설탕')}이 맛의 뼈대를 만들고, 깨소금 {amount(bibim, '깨소금')}을 절구에 빻아 넉넉히 올리는 게 특징이에요.</p>
      <p><a href={udong.recipeMeta.path}>볶음우동</a>은 진간장 {amount(udong, '진간장')}에 식초 {amount(udong, '식초')}, 황설탕 {amount(udong, '황설탕')}, 물 {amount(udong, '물')}을 섞은 양념장을 면 둘레에 둘러 졸이듯 볶아요. 식초가 들어가는 건 고추장 비빔국수와 볶음우동 두 가지예요.</p>

      <h2>잔치국수만 양념이 두 갈래예요</h2>
      <p><a href={janchi.recipeMeta.path}>잔치국수</a>는 국물과 양념장을 따로 만들어요. 국물은 물 {amount(janchi, '국물용 물')}에 채소를 끓이고 국간장 {amount(janchi, '국간장')}과 꽃소금 {amount(janchi, '꽃소금')}으로 간한 뒤 달걀을 풀어요. 양념장은 진간장 {amount(janchi, '진간장')}에 대파·청양고추·고춧가루·깨소금·황설탕·다진 마늘·참기름을 섞어요. 표의 간장 칸에 두 줄이 들어간 이유예요.</p>
      <p>국물에 이미 간이 되어 있기 때문에 양념장은 한꺼번에 붓는 재료가 아니에요. 레시피 글에서도 조금씩 넣으며 맞추라고 안내하고, 넉넉히 만들어서 남을 수 있다고 적어뒀어요. 면은 국물 냄비가 아니라 별도 냄비에서 삶아 찬물에 헹군 뒤 그릇에 담아요.</p>

      <h2>세 가지 국수의 공통점은 "양념은 나눠서"</h2>
      <p>세 국수 레시피는 공통적으로 만든 양념을 처음부터 다 넣지 않아요. 설마간장 비빔국수는 한 그릇에 2큰술부터 얹고 싱거우면 더하라고 하고, 고추장 비빔국수는 원하는 만큼 얹는 방식이라 표의 양념 전량을 다 먹어야 하는 레시피가 아니라고 설명해요. 잔치국수 양념장도 마찬가지예요. 그래서 표의 양념 분량은 "한 번에 넣는 양"이 아니라 "넉넉히 준비하는 양"으로 읽는 게 맞아요.</p>
      <p>면을 다루는 방식도 비슷해요. 비빔국수 두 가지와 잔치국수는 모두 삶은 면을 찬물에 헹궈요. 비빔국수는 물기를 충분히 빼야 양념이 묽어지지 않는다는 점을 레시피 글에서 따로 짚어요. 원본 삶는 시간은 잔치국수 소면이 약 3분 30초, 설마간장 비빔국수 중면이 약 3분이에요. 고추장 비빔국수는 끓어오를 때 찬물을 붓는 과정을 약 세 번 반복하는 방식이고요. 면 두께와 제품마다 다르니 포장 안내와 실제 익힘을 함께 봐주세요.</p>

      <h2>볶음우동은 기름이 가장 많이 들어가요</h2>
      <p>볶음우동은 국수 세 가지와 결이 달라요. 식용유 {amount(udong, '식용유')}에 대파를 넣어 향을 낸 뒤 돼지고기와 채소를 볶고, 면을 팬 가운데에 넣어 가장자리에 양념장을 둘러요. 면이 풀어지면 불을 올려 볶고, 마요네즈와 훈연멸치가루, 쪽파로 마무리해요. 우동면 1개 기준인 원본 배합을 두 배로 잡아 1–2인분 열을 만든 것도 다른 점이에요. 혼자 먹는다면 1–2인분 열을 다시 절반으로 줄이면 돼요.</p>

      <h2>상황별로 이렇게 골라보세요</h2>
      <ul class="note-list">
        <li>새콤달콤 매콤한 맛이 당기면 <a href={bibim.recipeMeta.path}>고추장 비빔국수</a>. 고명이 없어도 깨소금을 넉넉히 올리는 레시피라 재료가 단출해요.</li>
        <li>따뜻한 국물이 필요하거나 매운 걸 못 먹는 사람이 있다면 <a href={janchi.recipeMeta.path}>잔치국수</a>. 멸치 없이 채소로 국물을 내고, 매운 양념장은 각자 넣어요.</li>
        <li>고추장은 없고 익은 김치가 남아 있다면 <a href={ryu.recipeMeta.path}>설마간장 비빔국수</a>. 양념 재료가 네 가지뿐이라 준비가 가장 빨라요.</li>
        <li>국수보다 든든한 한 접시를 원하면 <a href={udong.recipeMeta.path}>볶음우동</a>. 고기와 채소가 들어가 반찬 없이도 한 끼가 돼요.</li>
      </ul>

      <h2>분량을 늘릴 때</h2>
      <p>네 레시피 모두 3–4인분 열은 1–2인분의 두 배예요. 일반적으로 면은 한 냄비에 많이 넣으면 물 온도가 떨어지고 서로 달라붙기 쉬우니, 냄비가 작다면 나눠 삶는 편이 다루기 편해요. 볶음우동도 레시피 글에서 작은 팬이라면 같은 비율로 나눠 볶으라고 권해요. 분량이 두 배라고 삶는 시간이나 볶는 시간을 두 배로 늘리지는 않아요. 종이컵과 숟가락 기준은 <a href={measuring.path}>{measuring.title}</a>에서 자세히 볼 수 있어요.</p>

      <aside class="source-note" aria-label="노트 출처">
        <p><strong>이 노트의 근거</strong><br />{rows.map((row, i) => <>{i > 0 && ' · '}<a href={link(row)}>{row.label}</a></>)}</p>
        <p>각 레시피 글은 원작자의 영상 설명란을 기준으로 정리했고, 이 노트는 그 재료표를 다시 비교한 편집 정리예요. 원본 배합은 바꾸지 않았고, 비교 관찰과 고르는 기준은 편집자가 덧붙였어요. 직접 조리 비교는 하지 않았으며 원작자와 제휴 관계는 없습니다.</p>
      </aside>
      <nav class="related-recipes" aria-labelledby="other-notes">
        <h2 id="other-notes">다른 비교·계량 노트</h2>
        <ul>{others.map(item => <li><a href={item.path}>{item.title}</a></li>)}</ul>
      </nav>
    </div>
  </article>
</BaseLayout>
