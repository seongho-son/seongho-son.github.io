---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notes, findRecipe, amount } from '../../data/notes.js';
import { recipes } from '../../data/recipes.js';

const note = notes.find(item => item.slug === 'paper-cup-measuring');
const others = notes.filter(item => item.slug !== note.slug);

const kimchi = findRecipe('/recipes/kimchi-jjigae/');
const jeyuk = findRecipe('/recipes/kim-seoul-jeyuk/');
const doenjang = findRecipe('/recipes/ryu-doenjang-jjigae/');
const sundubu = findRecipe('/recipes/ryu-spam-sundubu/');
const jjageuli = findRecipe('/recipes/aeri-potato-spam-stew/');
const dak = findRecipe('/recipes/paik-dakbokkeumtang/');
const janchi = findRecipe('/recipes/paik-janchi-guksu/');
const udong = findRecipe('/recipes/paik-bokkeum-udong/');

const fallbackLabels = { '/recipes/kimchi-jjigae/': '김치찌개', '/recipes/kim-seoul-jeyuk/': '제육볶음' };
const label = entry => entry.dish ?? fallbackLabels[entry.recipeMeta.path] ?? entry.recipeMeta.title;
const paperCupCount = recipes.filter(entry => /180ml/.test(entry.measureNote ?? '')).length;
const spoon15 = recipes.filter(entry => /15ml/.test(entry.measureNote ?? ''));
const examples = [
  { recipe: kimchi, name: '물' },
  { recipe: doenjang, name: '물' },
  { recipe: jjageuli, name: '물' },
  { recipe: dak, name: '진간장' },
  { recipe: kimchi, name: '돼지고기 목살' },
  { recipe: udong, name: '양배추' },
].filter(item => item.recipe);
---
<BaseLayout title={note.title} description={note.description} type="article">
  <article class="post note-page">
    <header class="post-header">
      <span class="category">레시피 비교·계량 노트</span>
      <h1>{note.title}</h1>
      <p class="byline">편집 정리 · 레시피 나와라 뚝딱</p>
    </header>
    <div class="post-content">
      <p>이 블로그의 레시피 재료표에는 "종이컵 3컵", "1큰술" 같은 표현이 자주 나와요. 계량컵이나 저울이 없어도 집에 있는 종이컵과 밥숟가락으로 따라 할 수 있게 옮겨 적은 거예요. 다만 원본 영상이 쓰는 단위는 g, ml, 계량컵, 계량스푼처럼 제각각이라, 옮기는 과정에 몇 가지 원칙을 정해두었어요. 이 노트는 그 기준과 이유를 실제 레시피 예시와 함께 정리한 안내예요.</p>
      <p class="note-disclaimer">원작자들의 영상 설명란을 바탕으로 사이트 재료표를 만들 때 쓰는 기준을 설명한 <strong>편집 정리</strong>예요. 아래 예시의 분량은 각 레시피 글의 재료표에서 그대로 가져왔어요.</p>

      <h2 id="cup">컵은 180ml 종이컵이에요</h2>
      <p>재료표의 "컵"은 모두 <strong>180ml 종이컵</strong>을 뜻해요. 지금 블로그에 있는 레시피 {recipes.length}개 중 {paperCupCount}개가 계량 안내에 180ml 종이컵 기준을 직접 적어두고 있어요. 물과 육수처럼 액체는 단위를 생략하지 않고 "종이컵 n컵"으로 적어요.</p>
      <p>원본이 200ml 계량컵이나 미국식 컵(약 240ml)을 쓰는 경우에는 같은 컵 수로 옮기지 않아요. 미국식 1컵을 종이컵 1컵으로 그대로 적으면 물이 꽤 모자라게 되거든요. 예를 들어 <a href={jjageuli.recipeMeta.path}>감자짜글이</a>는 원본이 미국식 컵을 써서, 물을 종이컵 기준으로 다시 계산해 {amount(jjageuli, '물')}로 적었어요. 원본에 ml가 있으면 괄호에 함께 남겨서, 계량컵이 있는 분은 그쪽을 따라도 돼요.</p>
      <div class="note-table-wrap" role="region" aria-label="레시피 재료표의 컵 표기 예시" tabindex="0">
        <table class="note-table note-table-narrow">
          <thead><tr><th scope="col">레시피</th><th scope="col">재료</th><th scope="col">1–2인분</th><th scope="col">3–4인분</th></tr></thead>
          <tbody>
            {examples.map(item => <tr><th scope="row"><a href={item.recipe.recipeMeta.path}>{label(item.recipe)}</a></th><td>{item.name}</td><td>{amount(item.recipe, item.name, 1)}</td><td>{amount(item.recipe, item.name, 2)}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="note-caption">각 레시피 재료표에서 그대로 옮긴 값이에요. 표가 넓으면 옆으로 밀어서 볼 수 있어요.</p>

      <h2 id="spoon">큰술은 밥숟가락으로 안내하지만, 15ml와 같다고 하지 않아요</h2>
      <p>양념의 "큰술"은 사이트 관례상 밥숟가락으로 계량할 수 있게 안내해요. 그런데 원본 레시피의 큰술은 보통 15ml 계량스푼이고, 집에서 쓰는 밥숟가락은 모양과 깊이가 제각각이에요. 그래서 두 가지가 같다고 단정하지 않아요. 대부분의 레시피 글은 "원본의 숟가락 단위를 옮겼고, 밥숟가락 크기에 따라 차이가 있을 수 있다"고 적어두고, 원본에 무게가 있으면 괄호에 함께 남겨요.</p>
      <p>양념 비율이 중요하거나 원본이 계량스푼을 분명히 쓰는 글은 15ml 계량스푼 기준을 따로 밝혀뒀어요. 지금은 {spoon15.map((entry, i) => <>{i > 0 && ', '}<a href={entry.recipeMeta.path}>{label(entry)}</a></>)} 글이 그래요. 계량스푼이 있다면 이 글들은 계량스푼으로 재는 게 원본에 더 가까워요.</p>
      <p>담는 방법도 글마다 확인해주세요. <a href={doenjang.recipeMeta.path}>차돌 된장찌개</a>는 된장을 {amount(doenjang, '된장')}처럼 "듬뿍" 담는 기준이고, 계량스푼 기준인 글은 대개 평평하게 깎아 담으라고 안내해요. 같은 1큰술이라도 수북하게 뜨면 양이 꽤 달라지니, 장이나 고춧가루처럼 맛을 크게 좌우하는 재료일수록 표 위의 계량 안내를 한 번 읽고 시작하는 게 좋아요.</p>
      <p>집에서 쓰는 밥숟가락이 어느 정도인지 궁금하다면, 계량스푼이 있을 때 물을 담아 한 번 비교해 두는 방법이 있어요. 한 번 알아두면 다른 레시피에서도 "우리 집 숟가락으로는 조금 덜" 같은 감을 잡기 쉬워요. 이건 편집자가 덧붙이는 제안이에요.</p>

      <h2 id="weight">고형 재료는 g과 ml가 같지 않아요</h2>
      <p>물은 1ml가 대략 1g이지만, 고기나 채소, 김치 같은 고형 재료는 그렇지 않아요. 썰어 담으면 사이사이에 빈 공간이 생기고, 재료마다 무게도 달라요. 그래서 원본의 200g을 "200ml니까 종이컵 1컵 남짓"처럼 바꾸지 않아요.</p>
      <p>실제 예를 보면 차이가 분명해요. <a href={kimchi.recipeMeta.path}>김치찌개</a>의 돼지고기 목살은 {amount(kimchi, '돼지고기 목살')}, <a href={udong.recipeMeta.path}>볶음우동</a>의 양배추는 {amount(udong, '양배추')}로 적혀 있어요. 같은 종이컵 1컵이어도 무게가 크게 다르고, 둘 다 180g과는 거리가 멀어요. 김치찌개 글은 김치와 고기를 잘라서 느슨하게 담는다고 밝혀두었고, 감자짜글이 글은 썬 채소를 눌러 담지 않는다고 적어뒀어요. 컵으로 재는 고형 재료는 담는 방법까지 함께 봐야 해요.</p>
      <p>원본에 부피나 개수 정보가 없고 믿을 만한 환산 근거도 없으면, 보기 좋은 숫자를 만들지 않고 원본 무게를 그대로 둬요. <a href={udong.recipeMeta.path}>볶음우동</a>의 당근({amount(udong, '당근')})과 대파({amount(udong, '대파')})가 그런 경우예요. <a href={janchi.recipeMeta.path}>잔치국수</a>의 간장도 원본 컵의 용량이 분명하지 않아 함께 적힌 무게({amount(janchi, '진간장')})로 안내해요.</p>

      <h2 id="original">원본 표현을 그대로 둔 경우도 있어요</h2>
      <p>모든 재료를 숫자로 바꾸지는 않아요. <a href={sundubu.recipeMeta.path}>스팸순두부찌개</a>의 식용유는 원본 표현 그대로 "{amount(sundubu, '식용유')}"예요. 병 입구와 냄비 크기에 따라 한 바퀴의 양이 달라서, 임의로 몇 큰술이라고 바꾸면 오히려 원본과 멀어질 수 있어요. "적당량", "조금", "취향껏"처럼 원본이 분량을 정하지 않은 재료도 숟가락 수를 지어내지 않고 그대로 적어요.</p>

      <h2 id="portion">1–2인분과 3–4인분은 이렇게 나눠요</h2>
      <p>재료표는 항상 <strong>1–2인분 | 3–4인분</strong> 두 열로 나란히 보여줘요. 먼저 원본의 인분이나 분량에서 기준 배합을 잡고, 거기서 두 분량을 계산해요. 원본이 2인분이면 왼쪽이 원본 그대로이고 오른쪽이 두 배예요. 원본이 다른 분량이면 그에 맞춰 나눠요. <a href={jeyuk.recipeMeta.path}>제육볶음</a>은 원본 한 근 분량을 3–4인분으로, 그 절반을 1–2인분으로 잡았고, <a href={udong.recipeMeta.path}>볶음우동</a>은 우동면 1개 기준인 원본을 두 배로 늘려 2인분으로 잡았어요.</p>
      <p>원본에 인분이 적혀 있지 않으면 편집자가 기준을 정하고, 그 사실을 재료표 아래에 밝혀요. 스팸순두부찌개가 그런 예로, 스팸 1캔과 순두부 1팩인 원본을 1–2인분으로 둔 편집상 기준이라고 적어뒀어요. 혼자 먹는다면 1–2인분 열을 절반으로 줄여 쓰면 돼요.</p>

      <h2 id="time">두 배 분량이라도 시간은 두 배가 아니에요</h2>
      <p>재료가 두 배라고 조리 시간까지 두 배로 늘리지 않아요. 물이 많으면 끓어오르는 데 시간이 더 걸리지만, 끓은 뒤 익는 시간은 재료 크기와 불 세기에 더 크게 좌우되거든요. 반대로 적은 분량이라고 시간을 무조건 반으로 줄이지도 않아요. 그래서 레시피 글에서는 "약 10분"처럼 시간을 적더라도 고기와 감자가 익었는지, 국물이 얼마나 졸았는지를 함께 확인하라고 안내해요.</p>
      <p>소금, 간장, 매운 재료는 분량을 두 배로 적어두되, 마지막에 간을 보며 조절하라는 팁을 따로 붙여요. 냄비나 팬이 작다면 3–4인분을 한 번에 넣기보다 같은 비율로 두 번 나눠 조리하는 편이 다루기 쉬워요. 스팸순두부찌개와 볶음우동 글이 이 방법을 권해요.</p>

      <aside class="source-note" aria-label="노트 출처">
        <p><strong>이 노트의 근거</strong><br />이 블로그 레시피 글들의 재료표와 계량 안내, 편집 기준을 정리했어요. 원본 배합과 편집자의 환산·팁은 각 레시피 글의 출처 영역에서 구분해 밝히고 있어요.</p>
      </aside>
      <nav class="related-recipes" aria-labelledby="other-notes">
        <h2 id="other-notes">다른 비교·계량 노트</h2>
        <ul>{others.map(item => <li><a href={item.path}>{item.title}</a></li>)}</ul>
      </nav>
    </div>
  </article>
</BaseLayout>
