---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notes, findRecipe, cell, amount } from '../../data/notes.js';

const note = notes.find(item => item.slug === 'ingredient-swaps');
const others = notes.filter(item => item.slug !== note.slug);
const measuring = notes.find(item => item.slug === 'paper-cup-measuring');

const toast = findRecipe('/recipes/paik-french-toast/');
const curry = findRecipe('/recipes/paik-pork-curry/');
const doenjang = findRecipe('/recipes/ryu-doenjang-jjigae/');
const gamjajeon = findRecipe('/recipes/paik-gamja-jeon/');
const musaengchae = findRecipe('/recipes/paik-musaengchae/');
const janchi = findRecipe('/recipes/paik-janchi-guksu/');
const omurice = findRecipe('/recipes/paik-omurice/');
const pasta = findRecipe('/recipes/mangae-one-pan-pasta/');
const chicken = findRecipe('/recipes/paik-chicken-deopbap/');
const kongnamulguk = findRecipe('/recipes/paik-kongnamul-guk/');

const fallbackLabels = { '/recipes/kimchi-jjigae/': '김치찌개' };
const label = entry => entry.dish ?? fallbackLabels[entry.recipeMeta.path] ?? entry.recipeMeta.title;

// 원본부터 특정 재료 없이 만드는 레시피. 대신 맛을 내는 재료는 각 레시피 재료표에서 그대로 읽어 온다.
const withoutRows = [
  { recipe: toast, missing: '우유·설탕', pattern: /^(식빵|달걀|꽃소금)/ },
  { recipe: curry, missing: '감자', pattern: /^(양파|당근|케첩)/ },
  { recipe: gamjajeon, missing: '밀가루·전분가루', pattern: /^(감자|물 · 믹서용)/ },
  { recipe: musaengchae, missing: '액젓', pattern: /^(꽃소금|식초|황설탕)/ },
  { recipe: janchi, missing: '멸치', pattern: /^(애호박|양파|표고버섯|당근)/ },
  { recipe: omurice, missing: '고기', pattern: /^(소고기다시다|양파|당근)/ },
  { recipe: pasta, missing: '토마토소스', pattern: /^(케첩|굴소스)/ },
].filter(row => row.recipe);

// 레시피 글의 tips에 이미 있는 대체 내용. kind는 그 글이 밝힌 출처 구분을 그대로 옮긴다.
const swapRows = [
  { path: '/recipes/paik-chicken-deopbap/', pattern: /^닭다리살/, to: '닭가슴살', note: '지방이 적어 팬에 붙기 쉬워요. 오래 굽지 말고 속까지 익혀요.', kind: '편집자 제안(원본 자막도 대체 가능하다고 언급)' },
  { path: '/recipes/paik-sausage-yachae-bokkeum/', pattern: /^파프리카/, to: '피망', note: '풋향이 강하고 단맛이 덜해요. 설탕부터 더하지 말고 맛을 봐요.', kind: '편집자 제안' },
  { path: '/recipes/paik-musaengchae/', pattern: /^깨소금/, to: '볶은 참깨를 빻아서', note: '넣기 직전에 굵게 빻아요. 소금과 섞으라는 뜻은 아니에요.', kind: '편집자 제안' },
  { path: '/recipes/paik-gamja-jeon/', pattern: /^청양고추 · 양념장용/, to: '맵지 않은 풋고추', note: '풋고추도 품종에 따라 매울 수 있어 먼저 확인해요.', kind: '편집자 제안' },
  { path: '/recipes/paik-gamja-jorim/', pattern: /^꽈리고추/, to: '풋고추', note: '껍질이 단단할 수 있고 향과 매운맛이 달라요. 마지막에 넣어요.', kind: '편집자 제안' },
  { path: '/recipes/paik-janchi-guksu/', pattern: /^표고버섯/, to: '다른 버섯', note: '같은 두께로 채 썰어요. 버섯 향이 국물의 바탕이라 맛이 달라져요.', kind: '편집자 제안' },
  { path: '/recipes/paik-pork-curry/', pattern: /뒷다리살/, to: '앞다리살·목살', note: '기름이 더 나오니 식용유를 줄이고 뜬 기름을 걷어요.', kind: '편집자 제안' },
  { path: '/recipes/paik-kongnamul-bulgogi/', pattern: /^대패삼겹살/, to: '불고기용 앞다리살·목살', note: '두꺼우면 익는 데 오래 걸려요. 겹친 고기를 떼어 확인해요.', kind: '편집자 제안' },
  { path: '/recipes/aeri-potato-spam-stew/', pattern: /^스팸/, to: '일반 스팸', note: '간이 더 셀 수 있어요. 간장과 된장을 덜 넣고 시작해요.', kind: '편집자 제안' },
  { path: '/recipes/mangae-one-pan-pasta/', pattern: /^프랑크소시지/, to: '햄·베이컨', note: '베이컨은 기름과 짠맛이 더 나오니 굴소스를 덜 넣어요.', kind: '편집자 제안' },
  { path: '/recipes/paik-miyeok-guk/', pattern: /양지/, to: '국거리용 사태·불고기용 소고기', note: '얇은 고기는 참기름에 오래 볶지 말고 바로 미역을 넣어요.', kind: '편집자 제안' },
  { path: '/recipes/paik-dubu-jorim/', pattern: /^들기름/, to: '참기름', note: '향이 달라지는 변형이에요. 원본 맛을 따르려면 들기름이에요.', kind: '시청자 반응' },
  { path: '/recipes/ryu-doenjang-jjigae/', pattern: /^차돌박이/, to: '대패 삼겹살·찌개용 돼지고기', note: '두툼한 고기는 채소와 함께 처음부터 넣어 충분히 익혀요.', kind: '편집자 제안' },
  { path: '/recipes/kimchi-jjigae/', pattern: /목살/, to: '참치캔', note: '고기를 오래 끓이는 단계가 빠져요. 새우젓과 국간장을 줄여요.', kind: '편집자 제안' },
  { path: '/recipes/paik-kongnamul-guk/', pattern: /^(MSG|꽃소금)/, to: 'MSG가 없을 때 꽃소금 대신 맛소금', note: '꽃소금에 맛소금을 더하는 게 아니라 꽃소금 자리에 넣어요.', kind: '원본 안내' },
].map(row => ({ ...row, recipe: findRecipe(row.path) })).filter(row => row.recipe);
---
<BaseLayout title={note.title} description={note.description} type="article">
  <article class="post note-page">
    <header class="post-header">
      <span class="category">레시피 비교·계량 노트</span>
      <h1>{note.title}</h1>
      <p class="byline">편집 정리 · 레시피 나와라 뚝딱</p>
    </header>
    <div class="post-content">
      <p>요리를 시작하려고 냉장고를 열었는데 우유가 떨어졌거나, 카레를 하려는데 감자가 없을 때가 있어요. 이 블로그에 들어오는 검색어를 보면 "우유 없이 프렌치토스트", "감자 없는 카레", "양파 없이 카레"처럼 재료 하나가 빠진 상황이 많았어요. 이 노트는 레시피 글마다 흩어져 있던 대체 정보를 한곳에 모은 정리예요. 원본부터 그 재료 없이 만드는 레시피와, 레시피 글의 팁에서 이미 다룬 대체 방법을 나눠서 적었어요.</p>
      <p class="note-disclaimer">각 레시피 글의 재료표와 팁을 다시 모은 <strong>편집 정리</strong>예요. 대체 재료로 직접 만들어 비교한 결과가 아니에요. 원작자가 안내한 내용과 편집자가 덧붙인 제안은 문장과 표에서 따로 표시했고, 분량은 모두 각 레시피 글의 재료표에서 그대로 가져왔어요.</p>

      <h2 id="milk">우유 없이 프렌치토스트 만들기</h2>
      <p><a href={toast.recipeMeta.path}>프렌치토스트</a> 글은 처음부터 우유가 들어가지 않는 버전이에요. 원본 영상에는 우유를 넣는 방법도 나오지만, 이 블로그는 그중 <strong>우유 없는 기본형</strong>만 골라 정리했어요. 1–2인분 기준으로 식빵 {amount(toast, '식빵')}에 달걀 {amount(toast, '달걀')}, 꽃소금 {amount(toast, '꽃소금')}이 전부예요. 우유를 빼고 다른 액체로 채우는 방식이 아니라, 달걀물만으로 식빵을 적셔 굽는 레시피라는 점이 핵심이에요. 설탕도 달걀물에 넣지 않고, 단맛은 다 구운 뒤 버터와 사과잼, 계핏가루, 연유 같은 고명으로 더해요.</p>
      <p>우유가 없으면 달걀물이 적어 보일 수 있어요. 레시피 글의 팁은 빵이 크거나 두꺼워 마지막 장에 달걀물이 모자라면 달걀을 하나 더 풀고 꽃소금도 한 꼬집 더해 간을 맞추라고 안내해요. 이 양 조절은 편집자가 덧붙인 제안이에요. 또 식빵을 달걀물에 오래 담가두면 속까지 젖어 가운데가 덜 익기 쉬우니 앞뒤를 빠르게 묻혀 바로 팬에 올리고, 두꺼운 식빵은 불을 조금 낮춰 천천히 구우라고 적어뒀어요. 뒤집개로 가운데를 눌렀을 때 달걀물이 배어 나오지 않을 때까지 익혀주세요.</p>
      <p>고명도 전부 갖출 필요는 없어요. 레시피 글은 집에 있는 것만 곁들여도 된다고 안내하되, 그러면 원본보다 단맛과 향이 달라진다고 밝혀뒀어요. 반대로 우유를 넣는 버전을 만들고 싶다면 이 글의 재료표에 우유를 더하기보다 원본 영상의 우유 버전을 따로 따라 하는 편이 맞아요. 두 버전의 배합을 섞지 않는다는 게 레시피 글의 기준이에요.</p>

      <h2 id="curry-potato">감자 없는 카레, 원본부터 감자를 넣지 않아요</h2>
      <p>"카레 감자 없이"를 찾는다면 <a href={curry.recipeMeta.path}>뒷다리살 카레</a>가 바로 그런 레시피예요. 재료표에 감자가 아예 없고, 고기와 양파가 중심이에요. 1–2인분은 돼지고기 뒷다리살 {amount(curry, '돼지고기 뒷다리살')}, 양파 {amount(curry, '양파')}, 당근 {amount(curry, '당근')}, 카레가루 {amount(curry, '카레가루')}, 물 {amount(curry, '물')}이에요. 원본은 5인분이고, 레시피 글은 그 ⅖를 2인분, ⅘를 4인분으로 계산했어요.</p>
      <p>감자 대신 무엇이 맛을 채우는지는 순서를 보면 알 수 있어요. 비계를 먼저 볶아 기름을 낸 뒤 살코기를 튀기듯 볶고, 양파를 갈색이 나도록 충분히 볶아요. 이어서 진간장 {amount(curry, '진간장')}과 케첩 {amount(curry, '케첩')}을 팬 가장자리에서 볶은 다음 물을 붓고, 카레가루를 넣기 전에 고기 국물을 먼저 끓여요. 불을 끈 뒤 버터 {amount(curry, '버터')}을 섞어 마무리해요. 감자의 전분이 없으니 걸쭉함은 카레가루와 오래 볶은 양파가 맡는 구조예요.</p>
      <p>레시피 글의 팁도 원본에 없는 감자나 고명은 추가하지 않았다고 밝혀요. 감자를 넣지 않는 대신 작은 냄비에서는 카레가 빨리 졸 수 있으니, 고기가 익기 전에 바닥이 마르면 물을 조금씩 보충하라고 안내해요. 감자를 꼭 넣고 싶다면 원본 배합이 아닌 변형으로 생각해주세요. 감자는 익는 데 시간이 걸리고 국물을 머금으니 물을 붓는 단계에서 함께 넣고 속까지 익었는지 확인하는 편이 안전하다는 건 일반 조리 원리에 기댄 편집자 제안이에요.</p>

      <h2 id="curry-onion">양파 없이 카레를 만든다면</h2>
      <p>반대로 양파가 없는 경우는 이 카레에서 조금 더 신중해야 해요. 1–2인분에 양파가 {amount(curry, '양파')}로, 고기 {amount(curry, '돼지고기 뒷다리살')}보다 많이 들어가요. 갈색이 날 때까지 볶은 양파가 단맛과 농도를 함께 만드는 재료라서, 레시피 데이터에는 양파를 대신할 재료가 따로 안내돼 있지 않아요.</p>
      <p>아래는 원본에 없는 편집자 제안이에요. 양파 없이 만든다면 고기와 당근만 볶은 뒤 같은 순서로 진행하되, 맛이 원본보다 덜 달고 국물이 묽게 느껴질 수 있다는 점을 감안해주세요. 양파에서 나오던 수분도 없으니 물을 처음부터 다 붓기보다 일부를 남겨뒀다가 카레가루를 푼 뒤 농도를 보며 더하는 편이 조절하기 쉬워요. 단맛이 아쉽다고 설탕부터 더하기보다, 레시피에 이미 들어 있는 케첩과 마지막 버터까지 넣은 뒤 맛을 보고 판단해주세요. 어떤 경우든 고기가 속까지 익었는지는 꼭 확인해요.</p>

      <h2 id="ssamjang">된장찌개에 쌈장, 넣는 비율과 없을 때</h2>
      <p>"된장찌개 쌈장"이나 "쌈장 찌개"를 찾는 분이라면 <a href={doenjang.recipeMeta.path}>차돌 된장찌개</a>를 보면 돼요. 이 레시피는 된장 {amount(doenjang, '된장')}에 쌈장 {amount(doenjang, '쌈장')}을 함께 넣어요. 쌈장이 된장의 3분의 1 정도인 보조 역할이고, 두 장 모두 숟가락에 듬뿍 담는 기준이에요. 넣는 시점도 같아서 물, 채소, 다진 마늘, 굵은소금과 함께 처음부터 풀어 강불로 끓여요. 끓기 시작하면 중불로 줄이고 식초 {amount(doenjang, '식초')}을 넣는 순서예요.</p>
      <p>레시피 글의 팁은 된장과 쌈장마다 짠맛이 다르다고 짚어요. 평소 쓰는 장이 짠 편이면 굵은소금 {amount(doenjang, '굵은소금')}은 남겨뒀다가 마지막에 간을 보고 넣고, 이미 짜졌다면 물을 조금씩 보충하라고 안내해요.</p>
      <p>쌈장이 없을 때의 대체는 레시피 데이터에 없어서, 아래는 편집자 제안이에요. 쌈장은 된장에 고추장 등 다른 양념이 섞인 장이라, 빠지면 국물의 단맛과 약간의 매콤함이 줄어든다고 볼 수 있어요. 쌈장 없이 끓인다면 된장만 표의 양대로 넣고, 모자란 맛은 처음부터 된장을 더 넣기보다 끓인 뒤 간을 보고 굵은소금이나 된장을 조금씩 더하는 쪽이 안전해요. 반대로 쌈장만으로 찌개를 끓이는 건 이 레시피의 배합과 다른 변형이에요. 차돌박이 대신 돼지고기를 쓰는 방법은 아래 표에 함께 정리했어요.</p>
      <p>이 찌개에는 감자도 {amount(doenjang, '감자')} 들어가요. 감자가 없다면 빼고 끓여도 다른 채소와 장의 순서는 그대로 따를 수 있다는 게 편집자 생각이에요. 감자가 주재료가 아니라 여러 채소 중 하나라서, 국물 맛보다 건더기 구성이 달라지는 정도로 보면 돼요.</p>

      <h2 id="without">처음부터 이 재료 없이 만드는 레시피</h2>
      <p>재료 하나를 빼고도 성립하도록 짜인 레시피도 있어요. 아래 표의 "빠진 재료"는 원본 레시피에 처음부터 들어가지 않는 재료이고, 오른쪽 칸은 그 자리를 채우는 재료를 각 레시피의 1–2인분 재료표에서 그대로 옮긴 값이에요.</p>
      <div class="note-table-wrap" role="region" aria-label="처음부터 특정 재료 없이 만드는 레시피" tabindex="0">
        <table class="note-table note-table-narrow">
          <thead><tr><th scope="col">레시피</th><th scope="col">빠진 재료</th><th scope="col">대신 맛과 모양을 내는 재료(1–2인분)</th></tr></thead>
          <tbody>
            {withoutRows.map(row => <tr><th scope="row"><a href={row.recipe.recipeMeta.path}>{label(row.recipe)}</a></th><td>{row.missing}</td><td>{cell(row.recipe, row.pattern)}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="note-caption">분량은 각 레시피 재료표의 1–2인분 열 값이에요. 표가 넓으면 옆으로 밀어서 볼 수 있어요.</p>
      <p><a href={gamjajeon.recipeMeta.path}>감자전</a>은 간 감자를 체에 밭쳐 바닥에 가라앉은 전분을 다시 섞는 방식이라, 별도 전분가루나 밀가루를 넣지 않아요. 받친 물을 바로 버리면 필요한 전분까지 잃는다는 점이 레시피 글의 주의점이에요. <a href={musaengchae.recipeMeta.path}>무생채</a>는 액젓이나 참기름 없이 꽃소금과 식초, 설탕으로 새콤달콤하게 무치는 소금 버전이에요. <a href={janchi.recipeMeta.path}>잔치국수</a>는 멸치 육수 대신 애호박·양파·당근·표고를 끓인 채소 국물에 국간장과 꽃소금으로 간해요.</p>
      <p><a href={omurice.recipeMeta.path}>오므라이스</a>는 볶음밥에 고기를 넣지 않고 양파와 당근만 볶으며, 소스는 밀가루를 볶아 케첩과 간장으로 끓여요. <a href={pasta.recipeMeta.path}>케첩 원팬 파스타</a>는 토마토소스 대신 케첩과 굴소스로 맛을 내고, 면을 같은 팬의 물에서 삶아 졸여요. 이 밖에 <a href={chicken.recipeMeta.path}>닭고기덮밥</a>의 훈연멸치가루는 원본 자막이 없어도 만들 수 있다고 안내해서 선택 재료로 구분돼 있고, <a href={kongnamulguk.recipeMeta.path}>콩나물국</a>의 MSG({amount(kongnamulguk, 'MSG')})도 원본에서 선택 사항이에요.</p>

      <h2 id="swaps">레시피별 재료 대체 표</h2>
      <p>각 레시피 글의 팁에서 이미 다룬 대체 방법을 모았어요. "원래 재료" 칸은 해당 레시피의 1–2인분 재료표 값이고, 오른쪽 "구분" 칸은 그 내용이 원작자의 안내인지, 편집자 제안인지, 시청자 반응인지를 레시피 글에 적힌 대로 옮긴 거예요. 대체해도 재료표 자체는 원본 그대로 두었으니, 분량은 원래 재료와 같은 무게로 시작하는 것을 기준으로 봐주세요.</p>
      <div class="note-table-wrap" role="region" aria-label="레시피별 재료 대체 정리표" tabindex="0">
        <table class="note-table">
          <thead><tr><th scope="col">레시피</th><th scope="col">원래 재료(1–2인분)</th><th scope="col">바꿔 쓸 재료</th><th scope="col">달라지는 점</th><th scope="col">구분</th></tr></thead>
          <tbody>
            {swapRows.map(row => <tr><th scope="row"><a href={row.recipe.recipeMeta.path}>{label(row.recipe)}</a></th><td>{cell(row.recipe, row.pattern)}</td><td>{row.to}</td><td>{row.note}</td><td>{row.kind}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="note-caption">자세한 조절 방법은 각 레시피 글의 팁에서 확인해주세요. 표가 넓으면 옆으로 밀어서 볼 수 있어요.</p>

      <h2 id="rules">재료를 바꿀 때 공통으로 보는 것</h2>
      <p>표를 모아 보면 대체 팁이 반복해서 짚는 지점이 세 가지예요. 첫째는 짠맛이에요. 일반 스팸, 베이컨, 참치캔처럼 이미 간이 된 재료로 바꾸면 원래 레시피의 간장·굴소스·새우젓을 그대로 넣었을 때 짜지기 쉬워요. 그래서 팁마다 양념을 덜 넣고 시작해 마지막에 맛을 보며 더하라고 안내해요. 둘째는 고기 두께와 익힘이에요. 차돌박이나 대패삼겹살처럼 얇은 고기를 두툼한 고기로 바꾸면 원본의 짧은 조리 시간으로는 속까지 익지 않을 수 있으니, 넣는 시점을 앞당기거나 익었는지 직접 확인해야 해요. 셋째는 기름이에요. 지방이 많은 부위로 바꾸면 식용유를 줄이고, 지방이 적은 닭가슴살은 팬에 붙지 않게 기름을 먼저 둘러요.</p>
      <p>대체는 원본과 맛이 같아지는 방법이 아니라 원본에 가깝게 만드는 방법이에요. 처음 만드는 레시피라면 재료표대로 한 번 따라 해보고, 바꿀 재료는 한 번에 하나씩만 바꾸는 편이 결과를 비교하기 쉬워요. 이건 편집자가 덧붙이는 제안이에요. 대체한 재료로 만든 음식도 남으면 한 김 식혀 냉장하고 1–2일 안에 먹고, 다시 데울 때는 가운데까지 충분히 끓여주세요. 종이컵과 숟가락 기준은 <a href={measuring.path}>{measuring.title}</a>에 따로 정리했어요.</p>

      <aside class="source-note" aria-label="노트 출처">
        <p><strong>이 노트의 근거</strong><br />{[toast, curry, doenjang, ...withoutRows.slice(2).map(row => row.recipe), chicken, kongnamulguk, ...swapRows.map(row => row.recipe)].filter((entry, i, list) => list.indexOf(entry) === i).map((entry, i) => <>{i > 0 && ' · '}<a href={entry.recipeMeta.path}>{label(entry)}</a></>)}</p>
        <p>각 레시피 글은 원작자의 영상 설명란·자막을 기준으로 정리했고, 이 노트는 그 재료표와 팁을 다시 모은 편집 정리예요. 분량은 레시피 재료표에서 그대로 가져왔어요. 원본에 없는 대체(양파 없는 카레, 쌈장 없는 된장찌개, 감자를 넣는 카레 등)는 일반 조리 원리에 기댄 편집자 제안이며, 대체 재료로 직접 조리해 검증하지는 않았어요. 원작자와 제휴 관계는 없습니다.</p>
      </aside>
      <nav class="related-recipes" aria-labelledby="other-notes">
        <h2 id="other-notes">다른 비교·계량 노트</h2>
        <ul>{others.map(item => <li><a href={item.path}>{item.title}</a></li>)}</ul>
      </nav>
    </div>
  </article>
