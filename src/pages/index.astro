---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS as tools } from '../lib/tools';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

---
<BaseLayout
  title="얼마받지"
  description="근로장려금·청년월세·부모급여 등 정부지원금, 내가 얼마 받는지 30초 만에 계산해 보세요. 개인정보 없이 브라우저에서 바로 자가진단."
  wide
>
  <section class="hero">
    <h1>내 정부지원금, 얼마 받지?</h1>
    <p class="lead">
      제도마다 사이트를 옮겨다닐 필요 없이, 가구·소득 정보만 넣으면
      받을 수 있는 지원금을 한 번에 찾아 드립니다. 개인정보는 받지 않습니다.
    </p>
    <a class="btn-tool" href={`${base}/check`}>🔎 내가 받을 수 있는 지원금 진단하기</a>
    <p class="hero-sub">
      한 번만 입력하면 근로장려금·자녀장려금·청년월세·주거급여·부모급여를 한 화면에서 판정하고,
      중복 수급 가능 여부까지 알려드립니다. 제도 하나만 볼 거라면
      <a href={`${base}/tools/labor-tax-credit`}>근로장려금 계산기</a>로 바로 가세요.
    </p>
  </section>

  <div class="ad-slot" aria-hidden="true"></div>

  <section>
    <h2>지원금 계산기</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <a class="tool-card" href={`${base}${t.href}`}>
          <div class="emoji">{t.emoji}</div>
          <div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2>지역별 지원금</h2>
      <a href={`${base}/regions`}>전체 보기 →</a>
    </div>
    <p>
      전국 공통 제도 외에, 내가 사는 지자체만 시행하는 지원금이 따로 있습니다.
      시·도와 시·군·구를 골라 우리 동네에서 신청할 수 있는 제도를 확인해 보세요.
    </p>
    <a class="btn-tool" href={`${base}/regions`}>📍 우리 지역 지원금 보기</a>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-title">
        <h2>지원금 정보</h2>
        <a href={`${base}/guides`}>전체 보기 →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`${base}/guides/${post.slug}`}>
              <span class="badge">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
