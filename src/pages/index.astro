---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS as tools } from '../lib/tools';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// 히어로 신뢰 지표 — 숫자는 실제 데이터에서 뽑는다(수동 관리 시 어긋난다)
const stats = [
  { n: `${tools.length}종`, label: '지원금 계산기' },
  { n: `${posts.length}개`, label: '제도 안내 글' },
];

---
<BaseLayout
  title="정부지원금 모의계산·자가진단"
  description="근로장려금·청년월세·부모급여 등 정부지원금, 내가 얼마 받는지 30초 만에 계산해 보세요. 개인정보 없이 브라우저에서 바로 자가진단."
  wide
>
  <section class="hero">
    <p class="hero-eyebrow">정부지원금 자가진단</p>
    <h1>내 정부지원금,<br />얼마 받지?</h1>
    <p class="lead">
      제도마다 사이트를 옮겨다닐 필요 없습니다.<br class="br-pc" />
      가구·소득만 넣으면 <strong>받을 수 있는 지원금을 한 번에</strong> 찾아 드립니다.
    </p>
    <div class="hero-cta">
      <a class="btn-tool" href={`${base}/check`}>내가 받을 수 있는 지원금 진단하기</a>
      <a class="btn-ghost" href={`${base}/tools`}>계산기만 볼게요</a>
    </div>
    <p class="hero-note">개인정보를 받지 않습니다 · 계산은 브라우저 안에서만 이루어집니다</p>

    <div class="stat-row">
      {stats.map((s) => (
        <div class="stat">
          <strong>{s.n}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="intro">
    <h2>얼마받지가 하는 일</h2>
    <p>
      정부지원금은 근로장려금은 국세청, 주거급여는 복지로, 청년월세는 국토교통부처럼 기관마다 흩어져 있어,
      제도 이름을 이미 알고 있어야만 찾아볼 수 있습니다. 얼마받지는 <strong>흩어진 제도를 한자리에 모아</strong>
      가구·소득만 넣으면 예상 수령액과 대상 여부를 바로 알려 주는 민간 정보 사이트입니다.
      관공서 용어를 <strong>일반인이 알아듣는 말로 옮겨</strong> 설명하고, 어떤 제도를 먼저 확인하면 되는지
      순서까지 안내합니다.
    </p>
    <p>
      모든 계산은 <strong>브라우저 안에서만</strong> 이루어지고, 입력한 소득·재산 정보는 어디에도 전송하거나
      저장하지 않습니다. 회원가입도 없습니다. 다만 얼마받지는 정부기관이 아니며 신청을 대행하지 않으므로,
      실제 자격 확인과 신청은 홈택스·복지로·고용24 같은 공식 창구에서 해야 합니다.
    </p>
    <h3>이런 분께 유용합니다</h3>
    <ul>
      <li>사회초년생·청년 — 청년월세, 주거급여, 근로장려금 대상인지 한 번에 확인하고 싶은 분</li>
      <li>자녀를 키우는 가구 — 부모급여·아동수당·자녀장려금 총액이 궁금한 분</li>
      <li>소득이 줄었거나 실직한 분 — 실업급여와 기초생활보장 커트라인을 가늠하고 싶은 분</li>
      <li>제도 이름은 몰라도 "내가 받을 게 있는지"부터 알고 싶은 분</li>
    </ul>
  </section>

  <section>
    <h2>지원금 계산기</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <a class="tool-card" href={`${base}${t.href}`}>
          <div class="emoji">{t.emoji}</div>
          <div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-title">
        <h2>지원금 정보</h2>
        <a href={`${base}/guides`}>전체 보기 →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`${base}/guides/${post.slug}`}>
              <span class="badge">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
