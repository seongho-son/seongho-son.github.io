---
import BaseLayout from '../layouts/BaseLayout.astro';
import { recipes } from '../data/recipes.js';
import { notes } from '../data/notes.js';
---
<BaseLayout title="집밥 레시피 모음" description="유튜브에서 찾은 인기 집밥 레시피를 요리할 때 보기 편하게 담았어요. 인분별 재료와 종이컵 계량, 단계별 조리법을 만나보세요." image="/images/og-home-v1.png" imageAlt="레시피 나와라 뚝딱! 다시 보고 싶은 유튜브 레시피, 여기에.">
  <Fragment slot="head">
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content="https://gibalpeople.com/images/og-home-v1.png" />
    <meta name="twitter:image:alt" content="레시피 나와라 뚝딱! 다시 보고 싶은 유튜브 레시피, 여기에." />
  </Fragment>
  <section class="recipe-index" aria-labelledby="recipes-title">
    <h1 id="recipes-title" class="sr-only">레시피 모음</h1>
    <p id="category-label" class="category" hidden></p>
    {recipes.map((entry, i) => (
      <article class="recipe-preview" data-category={entry.filterCategory ?? (/찌개|탕/.test(entry.recipeMeta.title) ? "stew" : /제육|볶음/.test(entry.recipeMeta.title) ? "stir-fry" : /두부조림|계란찜/.test(entry.recipeMeta.title) ? "side" : "other")}>
        <a href={entry.recipeMeta.path} tabindex="-1" aria-hidden="true"><img src={`https://i.ytimg.com/vi/${entry.videoId}/${entry.thumbnailFile ?? 'maxresdefault.jpg'}`} alt="" width={entry.thumbnailWidth ?? 1280} height={entry.thumbnailHeight ?? 720} style={entry.thumbnailFile === 'hqdefault.jpg' ? 'aspect-ratio:16/9;object-fit:cover' : undefined} fetchpriority={i === 0 ? 'high' : 'auto'} loading={i === 0 ? 'eager' : 'lazy'} /></a>
        <div>
          <p class="category">{entry.category}</p>
          <h2><a href={entry.recipeMeta.path}>{entry.recipeMeta.title}</a></h2>
          <p>{entry.preview}</p>
          <p class="preview-note">영상 · {entry.channel}</p>
          <a class="preview-link" href={`${entry.recipeMeta.path}#ingredients`}>재료부터 보기 →</a>
        </div>
      </article>
    ))}
    <section class="notes-block" aria-labelledby="notes-title">
      <h2 id="notes-title">레시피 비교·계량 노트</h2>
      <p>여러 레시피의 재료표를 나란히 놓고 비교하거나, 계량 기준을 풀어 쓴 편집 정리예요.</p>
      <ul>{notes.map(item => <li><a href={item.path}><strong>{item.title}</strong><span>{item.short}</span></a></li>)}</ul>
    </section>
  </section>
</BaseLayout>

<script>
  const category = new URLSearchParams(location.search).get('category');
  const labels: Record<string, string> = { stew: '찌개', 'stir-fry': '볶음', side: '반찬' };
  if (category && labels[category]) {
    document.querySelectorAll<HTMLElement>('.recipe-preview').forEach(item => {
      item.hidden = item.dataset.category !== category;
    });
    const label = document.querySelector<HTMLElement>('#category-label');
    if (label) { label.textContent = labels[category] + ' 레시피'; label.hidden = false; }
  }
</script>
