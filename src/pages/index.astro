---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS as tools } from '../lib/tools';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// 히어로 신뢰 지표 — 숫자는 실제 데이터에서 뽑는다(수동 관리 시 어긋난다)
const stats = [
  { n: `${tools.length}종`, label: '지원금 계산기' },
  { n: `${posts.length}개`, label: '제도 안내 글' },
];

---
<BaseLayout
  title="얼마받지"
  description="근로장려금·청년월세·부모급여 등 정부지원금, 내가 얼마 받는지 30초 만에 계산해 보세요. 개인정보 없이 브라우저에서 바로 자가진단."
  wide
>
  <section class="hero">
    <p class="hero-eyebrow">정부지원금 자가진단</p>
    <h1>내 정부지원금,<br />얼마 받지?</h1>
    <p class="lead">
      제도마다 사이트를 옮겨다닐 필요 없습니다.<br class="br-pc" />
      가구·소득만 넣으면 <strong>받을 수 있는 지원금을 한 번에</strong> 찾아 드립니다.
    </p>
    <div class="hero-cta">
      <a class="btn-tool" href={`${base}/check`}>내가 받을 수 있는 지원금 진단하기</a>
      <a class="btn-ghost" href={`${base}/tools`}>계산기만 볼게요</a>
    </div>
    <p class="hero-note">개인정보를 받지 않습니다 · 계산은 브라우저 안에서만 이루어집니다</p>

    <div class="stat-row">
      {stats.map((s) => (
        <div class="stat">
          <strong>{s.n}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="ad-slot" aria-hidden="true"></div>

  <section>
    <h2>지원금 계산기</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <a class="tool-card" href={`${base}${t.href}`}>
          <div class="emoji">{t.emoji}</div>
          <div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-title">
        <h2>지원금 정보</h2>
        <a href={`${base}/guides`}>전체 보기 →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`${base}/guides/${post.slug}`}>
              <span class="badge">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
