---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS as tools } from '../lib/tools';
import { sidoGroups, TOTAL_SERVICES } from '../lib/regions';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// 히어로 신뢰 지표 — 숫자는 실제 데이터에서 뽑는다(수동 관리 시 어긋난다)
const stats = [
  { n: `${tools.length}종`, label: '지원금 계산기' },
  { n: `${posts.length}개`, label: '제도 안내 글' },
  { n: `${TOTAL_SERVICES.toLocaleString('ko-KR')}건`, label: '지자체 지원사업' },
];
const topSido = sidoGroups.slice(0, 8);

---
<BaseLayout
  title="얼마받지"
  description="근로장려금·청년월세·부모급여 등 정부지원금, 내가 얼마 받는지 30초 만에 계산해 보세요. 개인정보 없이 브라우저에서 바로 자가진단."
  wide
>
  <section class="hero">
    <h1>내 정부지원금, 얼마 받지?</h1>
    <p class="lead">
      가구·소득만 넣으면 받을 수 있는 지원금을 바로 계산합니다. 개인정보는 받지 않습니다.
    </p>
    <div class="hero-cta">
      <a class="btn-tool" href={`${base}/check`}>한 번에 진단하기</a>
      <span class="hero-meta">
        계산기 {tools.length}종 · 안내 글 {posts.length}개 · 지자체 지원사업 {TOTAL_SERVICES.toLocaleString('ko-KR')}건
      </span>
    </div>
  </section>

  <div class="ad-slot" aria-hidden="true"></div>

  <section>
    <h2>지원금 계산기</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <a class="tool-card" href={`${base}${t.href}`}>
          <div class="emoji">{t.emoji}</div>
          <div>
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2>지역별 지원금</h2>
      <a href={`${base}/regions`}>전체 보기 →</a>
    </div>
    <p>
      전국 공통 제도 외에, 내가 사는 지자체만 시행하는 지원금이 따로 있습니다.
      같은 소득이어도 사는 곳에 따라 받을 수 있는 게 달라집니다.
    </p>
    <div class="chip-row">
      {topSido.map((g) => (
        <a class="chip" href={`${base}/regions/${g.slug}`}>{g.short} <span>{g.total}</span></a>
      ))}
      <a class="chip chip-more" href={`${base}/regions`}>전체 지역 →</a>
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-title">
        <h2>지원금 정보</h2>
        <a href={`${base}/guides`}>전체 보기 →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`${base}/guides/${post.slug}`}>
              <span class="badge">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p class="excerpt">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
