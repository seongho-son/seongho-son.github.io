---
import BaseLayout from '../layouts/BaseLayout.astro';
import { recipes } from '../data/recipes.js';
const { recipeMeta } = recipes[0];
---
<BaseLayout title="집밥 레시피 모음" description="유튜브에서 찾은 인기 집밥 레시피를 요리할 때 보기 편하게 담았어요. 인분별 재료와 종이컵 계량, 단계별 조리법을 만나보세요." image={recipeMeta.image} imageAlt={recipeMeta.imageAlt}>
  <section class="recipe-index" aria-labelledby="recipes-title">
    <h1 id="recipes-title" class="sr-only">레시피 모음</h1>
    {recipes.map((entry, i) => (
      <article class="recipe-preview">
        <a href={entry.recipeMeta.path} tabindex="-1" aria-hidden="true"><img src={`https://i.ytimg.com/vi/${entry.videoId}/maxresdefault.jpg`} alt="" width="1280" height="720" fetchpriority={i === 0 ? 'high' : 'auto'} loading={i === 0 ? 'eager' : 'lazy'} /></a>
        <div>
          <p class="category">{entry.category}</p>
          <h2><a href={entry.recipeMeta.path}>{entry.recipeMeta.title}</a></h2>
          <p>{entry.preview}</p>
          <p class="preview-note">영상 · {entry.channel}</p>
          <a class="preview-link" href={`${entry.recipeMeta.path}#ingredients`}>재료부터 보기 →</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
