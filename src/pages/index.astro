---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 도구 허브 — 계산기가 이 사이트의 핵심 자산
const tools = [
  {
    href: '/tools/labor-tax-credit',
    emoji: '💸',
    title: '근로장려금 계산기',
    desc: '가구유형·소득만 넣으면 예상 장려금을 바로 계산',
    ready: true,
  },
  {
    href: '/tools/child-tax-credit',
    emoji: '🧒',
    title: '자녀장려금 계산기',
    desc: '부양자녀 수·소득으로 예상 지급액 계산 (근로장려금과 중복 가능)',
    ready: true,
  },
  {
    href: '/tools/parenting-benefit',
    emoji: '👶',
    title: '출산·육아 지원금 총액 계산기',
    desc: '부모급여+첫만남+아동수당 총액 시뮬레이션',
    ready: true,
  },
  {
    href: '/tools/youth-rent',
    emoji: '🏠',
    title: '청년월세 지원 자격 체크',
    desc: '소득·나이·주거 조건으로 대상 여부 자가진단',
    ready: true,
  },
  {
    href: '/tools/unemployment-benefit',
    emoji: '💼',
    title: '실업급여 예상 수령액 계산기',
    desc: '나이·가입기간·평균임금으로 총 수령액 계산',
    ready: true,
  },
  {
    href: '/tools/median-income',
    emoji: '📊',
    title: '기준 중위소득 계산기',
    desc: '내 소득이 중위소득 몇 %인지, 어떤 복지 커트라인에 드는지 확인',
    ready: true,
  },
];
---
<BaseLayout
  title="얼마받지"
  description="근로장려금·청년월세·부모급여 등 정부지원금, 내가 얼마 받는지 30초 만에 계산해 보세요. 개인정보 없이 브라우저에서 바로 자가진단."
  wide
>
  <section class="hero">
    <h1>내 정부지원금, 얼마 받지?</h1>
    <p class="lead">
      제도마다 사이트를 옮겨다닐 필요 없이, 가구·소득 정보만 넣으면
      받을 수 있는 지원금을 한 번에 찾아 드립니다. 개인정보는 받지 않습니다.
    </p>
    <a class="btn-tool" href={`${base}/check`}>🔎 내가 받을 수 있는 지원금 진단하기</a>
    <p class="hero-sub">
      한 번만 입력하면 근로장려금·자녀장려금·청년월세·주거급여·부모급여를 한 화면에서 판정하고,
      중복 수급 가능 여부까지 알려드립니다. 제도 하나만 볼 거라면
      <a href={`${base}/tools/labor-tax-credit`}>근로장려금 계산기</a>로 바로 가세요.
    </p>
  </section>

  <div class="ad-slot" aria-hidden="true"></div>

  <section>
    <h2>지원금 계산기</h2>
    <div class="tool-grid">
      {tools.map((t) => (
        <a class={`tool-card ${t.ready ? '' : 'soon'}`} href={t.ready ? `${base}${t.href}` : '#'}>
          <div class="emoji">{t.emoji}</div>
          <div>
            <h3>{t.title} {!t.ready && <span class="soon-tag">준비 중</span>}</h3>
            <p>{t.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section>
    <div class="section-title">
      <h2>지역별 지원금</h2>
      <a href={`${base}/regions`}>전체 보기 →</a>
    </div>
    <p>
      전국 공통 제도 외에, 내가 사는 지자체만 시행하는 지원금이 따로 있습니다.
      시·도와 시·군·구를 골라 우리 동네에서 신청할 수 있는 제도를 확인해 보세요.
    </p>
    <a class="btn-tool" href={`${base}/regions`}>📍 우리 지역 지원금 보기</a>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-title">
        <h2>지원금 정보</h2>
        <a href={`${base}/guides`}>전체 보기 →</a>
      </div>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="badge">{post.data.category}</span>
            <h3><a href={`${base}/guides/${post.slug}`}>{post.data.title}</a></h3>
            <p class="excerpt">{post.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
