---
import { getCollection } from 'astro:content';
import { isCurrentGuide } from '../../lib/editorial.js';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).filter(p => isCurrentGuide(p.slug)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="장려금 조건과 사례"
  description="장려금의 가구·소득·재산 조건과 신청 방법을 실제 계산 과정으로 이해하는 안내."
  wide
>
  <h1>장려금 조건과 사례</h1>
  <p class="lead">내 조건을 이해하고 다음 행동을 정할 수 있도록, 비교 사례와 공식 근거를 함께 정리했습니다.</p>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-card" href={`${base}/guides/${post.slug}`}>
          <span class="badge">{post.data.category}</span>
          <h3>{post.data.title}</h3>
          <p class="excerpt">{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
