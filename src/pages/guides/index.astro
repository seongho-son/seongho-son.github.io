---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout
  title="지원금 정보"
  description="근로장려금·실업급여·청년월세·출산지원금 등 정부지원금의 자격과 신청 방법을 정리한 글 모음."
  wide
>
  <h1>지원금 정보</h1>
  <p class="lead">받을 수 있는 지원금을 놓치지 않도록, 자격과 신청 방법을 하나씩 정리했습니다.</p>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="post-card" href={`${base}/guides/${post.slug}`}>
          <span class="badge">{post.data.category}</span>
          <h3>{post.data.title}</h3>
          <p class="excerpt">{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
