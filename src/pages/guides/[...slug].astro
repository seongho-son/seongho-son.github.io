---
import { getCollection } from 'astro:content';
import { isCurrentGuide } from '../../lib/editorial.js';
import { toolLabel } from '../../lib/tools';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { post } = Astro.props;
const current = isCurrentGuide(post.slug);
const { Content, headings } = await post.render();
const sections = headings.filter((heading: { depth: number }) => heading.depth === 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article={current}
  ads={current}
  noindex={!current}
  publishedDate={post.data.pubDate.toISOString()}
  modifiedDate={post.data.updatedDate ? post.data.updatedDate.toISOString() : undefined}
>
  <article>
    <span class="badge">{post.data.category}</span>
    <h1>{post.data.title}</h1>
    <p class="meta">
      작성: <a href="/about/">얼마받지 운영자</a> · {fmt(post.data.pubDate)}
      {post.data.updatedDate && ` · 수정 ${fmt(post.data.updatedDate)}`}
    </p>

    {sections.length > 1 && (
      <nav aria-label="이 글의 목차" class="post-toc">
        <strong>이 글에서 확인할 내용</strong>
        <ul>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ul>
      </nav>
    )}

    {!current && <aside class="disclaimer-box"><strong>과거 안내 · 현재 신청 기준으로 사용하지 마세요</strong><p>이 글은 기존 자료를 보관한 것입니다. 현재는 근로·자녀장려금 안내에 집중하며, 이 분야의 제도 변경을 계속 반영하지 않습니다. 원래 작성일과 기준을 확인하고 <a href="https://www.bokjiro.go.kr/">복지로</a> 또는 해당 기관의 최신 공고를 확인하세요. <a href="/archive/">자료 보관 안내</a></p></aside>}
    {current && <p class="meta">2025년에 번 소득 · 2026년 신청 기준 / 확인 범위와 공식 원문은 본문 하단에 있습니다.</p>}
    <Content />

    <p class="meta"><a href="/editorial/">작성 기준과 정정 내역</a> · <a href="/contact/">이 글의 오류 제보</a></p>

    {current && post.data.relatedTool && toolLabel(post.data.relatedTool) && (
      <div class="cta-box">
        <a href={`${base}${post.data.relatedTool}`}>👉 {toolLabel(post.data.relatedTool)}</a>
      </div>
    )}

    <aside class="post-disclaimer">
      <p>
        본 글은 공개된 자료를 바탕으로 한 참고용 정보이며, 실제 지급 여부·금액은 관계 기관의
        심사 결과에 따라 달라집니다. 제도의 기준과 금액은 수시로 변경될 수 있으니 신청 전
        반드시 공식 사이트에서 최신 내용을 확인하세요. <strong>얼마받지는 정부기관이 아닌
        민간 정보 제공 사이트</strong>이며, 신청을 대행하지 않습니다.
      </p>
    </aside>
  </article>
</BaseLayout>

<style>
  .post-toc { margin: 1.5rem 0; padding: 1rem 1.25rem; border: 1px solid var(--border); border-radius: var(--radius); }
  .post-toc ul { margin-bottom: 0; }
</style>
